{
  "name": "@filitech/web-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:generate": "prisma generate --schema ../../packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema ../../packages/db/prisma/schema.prisma --skip-generate",
    "db:seed": "tsx ../../packages/db/prisma/seed.ts"
  },
  "prisma": {
    "schema": "../../packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@gsap/react": "^2.1.0",
    "@prisma/client": "^5.16.0",
    "@react-three/drei": "^9.105.0",
    "@react-three/fiber": "^8.16.0",
    "argon2": "^0.41.0",
    "framer-motion": "^11.2.0",
    "gsap": "^3.12.5",
    "jose": "^5.6.3",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.164.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.164.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.39",
    "prisma": "^5.16.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}