# ===== ENVIRONMENT VARIABLES - Filitech ERP =====
# Copy this file to .env and fill in the values for local development or production.

# ===== Database =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=filitech
POSTGRES_PASSWORD=filitech_dev
POSTGRES_DB=filitech_erp

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
JWT_PRIVATE_KEY_PATH=./jwt/private.key
JWT_PUBLIC_KEY_PATH=./jwt/public.key

# ===== Server =====
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== AWS / S3 (for file uploads) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# ===== Prisma =====
DATABASE_URL=postgres://filitech:filitech_dev@localhost:5433/filitech_erp

# ===== BullMQ / Redis Queues =====
REDIS_URL=redis://localhost:6379

# ===== OAuth / Social (if needed) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Feature Flags =====
FEATURE_2FA_ENABLED=true
FEATURE_BILLING_ENABLED=true