# =============================================================================
# FILITECH ERP — VARIÁVEIS DE AMBIENTE PARA VERCEL (PRODUÇÃO)
# =============================================================================
# Copie para .env.local (dev) ou configure no painel da Vercel (Settings → Environment Variables)
# Todas as chaves sensíveis devem ser definidas no painel da Vercel, NUNO no .env versionado.

# -----------------------------------------------------------------------------
# AUTH & SESSION (RS256 via jose) — OBRIGATÓRIO
# -----------------------------------------------------------------------------
# Gere com: openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key
# Converte para base64: base64 -w0 private.key  | tr -d '\n'
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Chave para criptografar segredo TOTP (AES-256-GCM) — 32 bytes hex
# Gere com: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# DATABASE (NEON POSTGRESQL) — OBRIGATÓRIO
# -----------------------------------------------------------------------------
# Formato: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# BILLING / PAYMENT GATEWAY — OBRIGATÓRIO (escolha UM)
# -----------------------------------------------------------------------------
# Opção A: Mercado Pago (Brasil)
BILLING_GATEWAY=mercadopago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx

# Opção B: Asaas (Brasil) — descomente se usar Asaas
# BILLING_GATEWAY=asaas
# ASAAS_API_KEY=asaas_xxxxxxxxxxxxxxxxxxxxxxxxx
# ASAAS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# FREE TIER & TRIAL
# -----------------------------------------------------------------------------
TRIAL_DAYS=7

# -----------------------------------------------------------------------------
# CRON SECRET (para /api/cron/*) — OBRIGATÓRIO
# Gere com: openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# STORAGE (CLOUDFLARE R2) — OBRIGATÓRIO para XMLs fiscais, fotos, uploads
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=filitech-assets
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# -----------------------------------------------------------------------------
# EMAIL (RESEND) — OBRIGATÓRIO para reset senha, notificações, convites
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@seudominio.com.br
EMAIL_REPLY_TO=suporte@seudominio.com.br

# -----------------------------------------------------------------------------
# WHATSAPP (META CLOUD API) — OPCIONAL (módulo whatsapp)
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# OPEN FINANCE (PLUGGY) — OBRIGATÓRIO para Family Tier (B2C) + Conciliação B2B
# -----------------------------------------------------------------------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_URL=https://seudominio.com.br/api/webhooks/pluggy

# -----------------------------------------------------------------------------
# FISCAL (FOCUS NFE) — OBRIGATÓRIO para emissão NFC-e/NFe
# -----------------------------------------------------------------------------
FOCUS_NFE_API_TOKEN=
FOCUS_NFE_BASE_URL=https://api.focusnfe.com.br/v2

# -----------------------------------------------------------------------------
# BACKUP ENCRYPTION — OBRIGATÓRIO para pg_dump criptografado
# -----------------------------------------------------------------------------
# 32 bytes hex
BACKUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# APP URLS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://seudominio.com.br
NEXT_PUBLIC_ADMIN_URL=https://admin.seudominio.com.br
NEXT_PUBLIC_API_URL=https://seudominio.com.br/api

# -----------------------------------------------------------------------------
# FEATURE FLAGS (rollout gradual)
# -----------------------------------------------------------------------------
FEATURE_NEW_POS_LAYOUT=0
FEATURE_ACCOUNTING_MARKETPLACE=1

# =============================================================================
# NOTAS IMPORTANTES PARA VERCEL
# =============================================================================
# 1. No painel da Vercel: Settings → Environment Variables → Adicione TODAS acima
#    Marque: Production, Preview, Development
# 2. O Vercel NÃO lê .env.local em produção — só variáveis configuradas no painel
# 3. JWT_PRIVATE_KEY_BASE64/JWT_PUBLIC_KEY_BASE64: gere localmente, cole no painel
# 4. DATABASE_URL: use connection pooling do Neon (ep-xxx-pooler.xxx.neon.tech)
# 5. Webhooks: configure nas UIs do Mercado Pago/Asaas/Meta/Pluggy apontando para:
#    - https://seudominio.com.br/api/webhooks/billing
#    - https://seudominio.com.br/api/webhooks/ifood
#    - https://seudominio.com.br/api/webhooks/whatsapp
#    - https://seudominio.com.br/api/webhooks/pluggy
# 6. Domínios: adicione seudominio.com.br + admin.seudominio.com.br no Vercel
# 7. Edge Functions: as rotas /api/cron/* e /api/webhooks/* rodam no Edge (config no vercel.json)