# =============================================================================
# FILITECH ERP — VARIÁVEIS DE AMBIENTE COMPLETAS PARA VERCEL + NEON
# =============================================================================
# Copie este arquivo para .env.local (dev) ou configure no painel da Vercel
# (Settings → Environment Variables → Adicione cada uma)
# Marque: Production ✓  Preview ✓  Development ✓
# NUNCA commite este arquivo com secrets reais no Git
# =============================================================================

# =============================================================================
# AUTH & SESSÃO (RS256 via jose) — OBRIGATÓRIO
# =============================================================================
# Gere com: openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key
# Converte para base64: base64 -w0 private.key | tr -d '\n'  → JWT_PRIVATE_KEY_BASE64
#                        base64 -w0 public.key  | tr -d '\n'  → JWT_PUBLIC_KEY_BASE64
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Chave para criptografar segredo TOTP (AES-256-GCM) — 32 bytes hex
# Gere com: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# =============================================================================
# DATABASE (NEON POSTGRESQL) — OBRIGATÓRIO
# =============================================================================
# Use a URL POOLED do Neon (connection pooling) — Dashboard Neon → Connection Details → Pooled connection
# Formato: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require
DATABASE_URL=

# =============================================================================
# BILLING / PAYMENT GATEWAY — OBRIGATÓRIO (escolha UM)
# =============================================================================
# Opção A: Mercado Pago (Brasil) — RECOMENDADO
BILLING_GATEWAY=mercadopago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Opção B: Asaas (Brasil) — descomente se usar Asaas
# BILLING_GATEWAY=asaas
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_SECRET=

# Opção C: Stripe (Internacional) — descomente se usar Stripe
# BILLING_GATEWAY=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# FREE TIER & TRIAL
# =============================================================================
TRIAL_DAYS=7

# =============================================================================
# CRON SECRET (para /api/cron/*) — OBRIGATÓRIO
# =============================================================================
# Gere com: openssl rand -hex 32
CRON_SECRET=

# =============================================================================
# STORAGE (CLOUDFLARE R2) — OBRIGATÓRIO para XMLs fiscais, fotos, uploads
# =============================================================================
# Cloudflare Dashboard → R2 → Create bucket "filitech-assets"
# Settings → API Tokens → Create token with R2 permissions
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=filitech-assets
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# =============================================================================
# EMAIL (RESEND) — OBRIGATÓRIO para reset senha, notificações, convites
# =============================================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@seudominio.com.br
EMAIL_REPLY_TO=suporte@seudominio.com.br

# =============================================================================
# WHATSAPP (META CLOUD API) — OPCIONAL (módulo whatsapp)
# =============================================================================
# developers.facebook.com → Meus Apps → WhatsApp → Configuração
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_SECRET=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=filitech_webhook_verify_2025

# =============================================================================
# OPEN FINANCE (PLUGGY) — OBRIGATÓRIO para Family Tier (B2C) + Conciliação B2B
# =============================================================================
# console.pluggy.ai → Credenciais
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_KEY=
PLUGGY_WEBHOOK_URL=https://seudominio.com.br/api/webhooks/pluggy

# =============================================================================
# FISCAL (FOCUS NFE) — OBRIGATÓRIO para emissão NFC-e/NFe
# =============================================================================
# Cadastro no Focus NFe → Minha Conta → Token da API
FOCUS_NFE_API_TOKEN=
FOCUS_NFE_BASE_URL=https://api.focusnfe.com.br/v2

# =============================================================================
# IFOOD — OPCIONAL (módulo restaurantes)
# =============================================================================
IFOOD_WEBHOOK_SECRET=
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# =============================================================================
# BACKUP ENCRYPTION — OBRIGATÓRIO para pg_dump criptografado
# =============================================================================
# 32 bytes hex
BACKUP_ENCRYPTION_KEY=

# =============================================================================
# TRIAL & URLS
# =============================================================================
TRIAL_DAYS=7
NEXT_PUBLIC_APP_URL=https://seudominio.com.br
NEXT_PUBLIC_ADMIN_URL=https://admin.seudominio.com.br
NEXT_PUBLIC_API_URL=https://seudominio.com.br/api

# =============================================================================
# FEATURE FLAGS (rollout gradual)
# =============================================================================
FEATURE_NEW_POS_LAYOUT=0
FEATURE_ACCOUNTING_MARKETPLACE=1

# =============================================================================
# OPENAI / IA (opcional - para recursos futuros)
# =============================================================================
# OPENAI_API_KEY=

# =============================================================================
# SENTRY / MONITORAMENTO (opcional)
# =============================================================================
# SENTRY_DSN=

# =============================================================================
# LEGENDA — O QUE VOCÊ PRECISA PREENCHER (substitua os valores acima)
# =============================================================================
# [ ] JWT_PRIVATE_KEY_BASE64      → base64 da chave privada RSA (openssl)
# [ ] JWT_PUBLIC_KEY_BASE64       → base64 da chave pública RSA (openssl)
# [ ] TOTP_ENCRYPTION_KEY         → openssl rand -hex 32
# [ ] DATABASE_URL                → Neon pooled connection string
# [ ] MERCADO_PAGO_ACCESS_TOKEN   → MP Developers → Credenciais produção
# [ ] MERCADO_PAGO_WEBHOOK_SECRET → MP → Webhooks → Criar webhook
# [ ] R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY → Cloudflare R2 → API Tokens
# [ ] RESEND_API_KEY              → Resend.com → API Keys
# [ ] EMAIL_FROM                  → Domínio verificado no Resend
# [ ] PLUGGY_CLIENT_ID / SECRET   → Console Pluggy → Credenciais
# [ ] PLUGGY_API_KEY              → JWT token do Pluggy
# [ ] FOCUS_NFE_API_TOKEN         → Painel Focus NFe → Token da API
# [ ] IFOOD_*                     → Portal iFood Desenvolvedores
# [ ] BACKUP_ENCRYPTION_KEY       → openssl rand -hex 32
# [ ] CRON_SECRET                 → openssl rand -hex 32
# [ ] TOTP_ENCRYPTION_KEY         → openssl rand -hex 32
# [ ] META_WEBHOOK_SECRET         → Meta Developers → WhatsApp → Webhook
# [ ] META_WEBHOOK_VERIFY_TOKEN   → Token aleatório para verificação do webhook
# [ ] NEXT_PUBLIC_APP_URL         → Seu domínio de produção (ex: https://app.seudominio.com.br)
# [ ] NEXT_PUBLIC_ADMIN_URL       → Subdomínio admin (ex: https://admin.seudominio.com.br)
# [ ] NEXT_PUBLIC_API_URL         → API base URL (ex: https://app.seudominio.com.br/api)

# =============================================================================
# COMANDOS ÚTEIS PARA GERAR SECRETS (rode no terminal)
# =============================================================================
# Chaves RSA 2048 para JWT RS256:
# openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key
# base64 -w0 private.key | tr -d '\n'  # → JWT_PRIVATE_KEY_BASE64
# base64 -w0 public.key  | tr -d '\n'  # → JWT_PUBLIC_KEY_BASE64

# Secrets hex 32 bytes:
# openssl rand -hex 32  # → TOTP_ENCRYPTION_KEY, CRON_SECRET, BACKUP_ENCRYPTION_KEY, TOTP_ENCRYPTION_KEY

# Meta Webhook Verify Token:
# openssl rand -hex 32  # → META_WEBHOOK_VERIFY_TOKEN