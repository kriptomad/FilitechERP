# ===== ENVIRONMENT VARIABLES - Filitech ERP (100% Vercel) =====
# Copy this file to .env and fill in the values for local development or production.
# Para Vercel: configure estas mesmas variáveis no Dashboard > Settings > Environment Variables

# ===== Database (Vercel Postgres / Neon) =====
# Obtenha no Neon Console ou Vercel Dashboard > Storage > Postgres
DATABASE_URL=postgres://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/filitech_erp?sslmode=require
# Para compatibilidade com código legado:
POSTGRES_HOST=ep-xxx.us-east-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha
POSTGRES_DB=filitech_erp

# ===== Redis (Vercel KV / Upstash) =====
# Obtenha no Vercel Dashboard > Storage > KV Database
REDIS_URL=rediss://usuario:senha@xxx.upstash.io:6379
# Para compatibilidade:
REDIS_HOST=xxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=senha

# ===== JWT (RS256) =====
# Gere localmente: openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key
# Converta para base64: base64 -w 0 private.key > private.b64
# Cole o conteúdo do .b64 aqui (uma linha só):
JWT_PRIVATE_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1JSU...
JWT_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTU...

# Para compatibilidade local (arquivos):
JWT_PRIVATE_KEY_PATH=./jwt/private.key
JWT_PUBLIC_KEY_PATH=./jwt/public.key

# ===== Server =====
PORT=3001
NODE_ENV=production

# ===== URLs (Produção) =====
# URL pública da API (para o frontend chamar)
NEXT_PUBLIC_API_URL=https://filitecherp.vercel.app
# URL pública do app (ERP/PDV)
NEXT_PUBLIC_ERP_APP_URL=https://filitecherp.vercel.app
# URL pública do landing/frontend
NEXT_PUBLIC_APP_URL=https://filitecherp.vercel.app

# ===== AWS / S3 / R2 (para uploads de arquivo) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# ===== OAuth / Social (opcional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Feature Flags =====
FEATURE_2FA_ENABLED=true
FEATURE_BILLING_ENABLED=true

# ===== Vercel Specific =====
# Não defina localmente - o Vercel define automaticamente
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=filitecherp.vercel.app