# =============================================================================
# FILITECH ERP — ARQUIVO .ENV COMPLETO PARA VERCEL (PRODUÇÃO)
# =============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local (desenvolvimento) OU
# 2. Copie TODAS as variáveis abaixo para o painel da Vercel:
#    Settings → Environment Variables → Adicione cada uma
#    Marque: Production ✓  Preview ✓  Development ✓
# 3. NUNCA commite este arquivo com secrets reais no Git
# =============================================================================

# =============================================================================
# AUTH & SESSÃO (RS256 via jose) — OBRIGATÓRIO
# =============================================================================
# Gere as chaves RSA 2048 bits:
#   openssl genrsa -out private.key 2048
#   openssl rsa -in private.key -pubout -out public.key
#   base64 -w0 private.key | tr -d '\n'  → JWT_PRIVATE_KEY_BASE64
#   base64 -w0 public.key  | tr -d '\n'  → JWT_PUBLIC_KEY_BASE64
JWT_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1JSUY4Z0lCQURBTkJna3Foa2lHOXcwQkFRRUZBQVNDQ1N3d2dna29CZ2dxaGtpRzkyTmtBS...
JWT_PUBLIC_KEY_BASE64=LS0tLS1CRUdJTiBQVUJMSUMtLS0tLQpNSUlDSWpDQ0FZSUt3B0lCQURBTkJna3Foa2lHOXcwQkFRRUZBQVNDQ1N3d2dna29CZ2dxaGtpRzkyTmtBS...

# Chave para criptografar segredo TOTP (AES-256-GCM) — 32 bytes hex
# Gere com: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=a1b2c3d4e5f678901234567890abcdef1234567890abcdef1234567890abcdef

# =============================================================================
# DATABASE (NEON POSTGRESQL) — OBRIGATÓRIO
# =============================================================================
# Use SEMPRE a URL POOLED do Neon (connection pooling)
# Dashboard Neon → Connection Details → Pooled connection
# Formato: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_U3u2SMkDboqc@ep-polished-tooth-b8k2tjam-pooler.c-14.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# =============================================================================
# BILLING / PAYMENT GATEWAY — OBRIGATÓRIO (escolha UM)
# =============================================================================
# Opção A: Mercado Pago (Brasil) — RECOMENDADO
BILLING_GATEWAY=mercadopago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx

# Opção B: Asaas (Brasil) — descomente se usar Asaas
# BILLING_GATEWAY=asaas
# ASAAS_API_KEY=asaas_xxxxxxxxxxxxxxxxxxxxxxxxx
# ASAAS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# FREE TIER & TRIAL
# =============================================================================
TRIAL_DAYS=7

# =============================================================================
# CRON SECRET (para /api/cron/*) — OBRIGATÓRIO
# =============================================================================
# Gere com: openssl rand -hex 32
CRON_SECRET=a1b2c3d4e5f678901234567890abcdef1234567890abcdef1234567890abcdef

# =============================================================================
# STORAGE (CLOUDFLARE R2) — OBRIGATÓRIO para XMLs fiscais, fotos, uploads
# =============================================================================
# Cloudflare Dashboard → R2 → Create bucket "filitech-assets"
# Settings → API Tokens → Create token with R2 permissions
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=filitech-assets
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

