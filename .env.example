# ─── Banco (Neon Postgres) ────────────────────────────────────────────────
# Connection string do Neon. Use a URL "pooled" (termina em -pooler) para o
# runtime e a "direct" para migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/filitech_erp?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/filitech_erp?sslmode=require"

# ─── Auth (RS256) — OBRIGATÓRIO ───────────────────────────────────────────
# Serverless não tem filesystem: as chaves vêm de variáveis de ambiente, nunca
# de arquivo. Gere com:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem
#
# No painel da Vercel, cole o base64 SEM aspas e sem quebras de linha.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Pagamento (Cap. 2.7 / 20.4) ───────────────────────────────────────────
# Escolha UM provedor. Sem isto, planos pagos ficam indisponíveis e o checkout
# responde 503 com orientação (nunca ativa acesso sem pagamento).
# Valores: mercadopago | asaas
BILLING_GATEWAY=""

# Mercado Pago — Configurações > Suas credenciais > ACCESS_TOKEN
MERCADO_PAGO_ACCESS_TOKEN=""
# Segredo usado para validar a assinatura do webhook (Configurações > Webhooks).
MERCADO_PAGO_WEBHOOK_SECRET=""

# Asaas — Integrações > Chave de acesso
ASAAS_API_KEY=""
ASAAS_WEBHOOK_SECRET=""

# ─── Cron (Cap. 2.7.4) ─────────────────────────────────────────────────────
# A Vercel envia este valor no header Authorization ao chamar /api/cron/*.
# Sem ele, as rotas de cron ficam inertes.
CRON_SECRET=""

# ─── E-mail (Cap. 14.3) ────────────────────────────────────────────────────
# Sem RESEND_API_KEY, o link de redefinição de senha é registrado no log do
# servidor em vez de enviado — funcional em dev, insuficiente em produção.
RESEND_API_KEY=""
EMAIL_FROM="Filitech ERP <nao-responda@seudominio.com.br>"

# ─── iFood (Cap. 11.1) ─────────────────────────────────────────────────────
IFOOD_WEBHOOK_SECRET=""

# ─── Cache (opcional) ──────────────────────────────────────────────────────
# Sem REDIS_URL o cache de módulos degrada para memória do processo; a
# autorização continua correta porque o Postgres é a fonte de verdade.
REDIS_URL=""

# ─── Storage (Cap. 3.3) ────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="filitech-assets"

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"