// ─────────────────────────────────────────────────────────────────────────
// OPEN FINANCE (PLUGGY) — Cap. 17.4.1 / 22.5
// ─────────────────────────────────────────────────────────────────────────

enum OpenFinanceConsentStatus {
  UPDATING
  UPDATED
  LOGIN_ERROR
  OUTDATED
  WAITING_USER_INPUT
}

/// Consentimento real de Open Finance (Cap. 22.5) — um registro por instituição
/// conectada via agregador (Pluggy). `itemId` é o identificador do agregador, nunca
/// as credenciais bancárias do usuário (que nunca transitam nem são persistidas pelo
/// Filitech — o fluxo de login acontece inteiramente dentro do widget do agregador).
model OpenFinanceConsent {
  id                 String                   @id @default(uuid())
  tenantId           String
  provider           String                   @default("PLUGGY")
  itemId             String                   @unique
  institutionName    String
  status             OpenFinanceConsentStatus @default(UPDATING)
  consentExpiresAt   DateTime
  lastSyncedAt       DateTime?
  createdAt          DateTime                 @default(now())

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts           PersonalAccount[] // preenchido quando o tenant é PERSONAL (Cap. 22.5)
  bankAccounts       BankAccount[]     // preenchido quando o tenant é BUSINESS (Cap. 17.4.1) — mutuamente exclusivo com `accounts` na prática, pois um tenant tem um único `Plan.audience`

  @@index([tenantId, status])
  @@map("open_finance_consents")
}

