// prisma/schema.prisma — BIBLE_ENGINEERING_V2 (Capítulos 5 + 12)
// Fonte de verdade: BIBLE_ENGINEERING_V2.md

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANCY, PLANOS E MOTOR DE MÓDULOS (BILLING À LA CARTE) — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id                String       @id @default(uuid())
  parentTenantId    String?
  slug              String       @unique
  legalName         String
  tradeName         String
  cnpj              String       @unique
  status            TenantStatus @default(TRIAL)
  gracePeriodEndsAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parentTenant      Tenant?       @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  childTenants       Tenant[]      @relation("TenantHierarchy")
  subscriptions     Subscription[]
  tenantModules     TenantModule[]
  users             User[]
  clients           Client[]
  suppliers         Supplier[]
  products          Product[]
  productBatches    ProductBatch[]
  productSerials    ProductSerial[]
  productVariants   ProductVariant[]
  recipes           Recipe[]
  productionBatches ProductionBatch[]
  workOrders        WorkOrder[]
  sales             Sale[]
  cashRegisters     CashRegister[]
  stockMovements    StockMovement[]
  fiscalDocuments   FiscalDocument[]
  accountsPayable   AccountPayable[]
  accountsReceivable AccountReceivable[]
  returnableLedgerEntries ReturnableContainerLedger[]
  services          Service[]
  appointments      Appointment[]
  clientPackages    ClientServicePackage[]
  comandas          Comanda[]
  restaurantTables  RestaurantTable[]
  opticalPrescriptions OpticalPrescription[]
  pets              Pet[]
  vaccineRecords    VaccineRecord[]
  vehicles          Vehicle[]
  vehicleListings   VehicleListing[]
  serviceContracts  ServiceContract[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  loyaltyProgram    LoyaltyProgram?
  loyaltyAccounts   LoyaltyAccount[]
  referralCode      ReferralCode?
  referredAs        Referral?         @relation("ReferredTenant")

  onlineStoreSettings        OnlineStoreSettings?
  fiscalDocumentEvents       FiscalDocumentEvent[]
  chartOfAccounts            ChartOfAccount[]
  costCenters                CostCenter[]
  purchaseOrders             PurchaseOrder[]
  inventoryCounts            InventoryCount[]
  reportDefinitions          ReportDefinition[]
  scheduledReports           ScheduledReport[]
  dashboardLayouts           DashboardLayout[]
  dataImportJobs             DataImportJob[]
  taxRules                   TaxRule[]
  ibsCbsRegimeElections      TenantIbsCbsRegimeElection[]
  accountingFirmProfile      AccountingFirmProfile?
  engagementsAsFirm          AccountingEngagement[] @relation("EngagementsAsFirm")
  engagementsAsClient        AccountingEngagement[] @relation("EngagementsAsClient")
  accountingTasksAsFirm      AccountingTask[] @relation("AccountingTasksAsFirm")
  accountingTasksAsClient    AccountingTask[] @relation("AccountingTasksAsClient")
  officialTaxDocuments       OfficialTaxDocument[] @relation("OfficialTaxDocumentsOfTenant")
  officialTaxDocumentsGenerated OfficialTaxDocument[] @relation("OfficialTaxDocumentsGeneratedByFirm")
  @@index([status])
  @@index([parentTenantId])
  @@map("tenants")
}

model Plan {
  id              String   @id @default(uuid())
  code            String   @unique
  label           String
  basePrice       Decimal  @db.Decimal(10, 2)
  includedModules String[]
  active          Boolean  @default(true)

  subscriptions   Subscription[]

  @@map("plans")
}

model Module {
  id           String   @id @default(uuid())
  code         String   @unique
  label        String
  monthlyPrice Decimal  @db.Decimal(10, 2)
  description  String
  active       Boolean  @default(true)

  tenantModules TenantModule[]

  @@map("modules")
}

model TenantModule {
  id         String   @id @default(uuid())
  tenantId   String
  moduleCode String
  active     Boolean  @default(true)
  activatedAt DateTime @default(now())
  deactivatedAt DateTime?

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleCode], references: [code])

  @@unique([tenantId, moduleCode])
  @@index([tenantId, active])
  @@map("tenant_modules")
}

// System parameters for global configuration (2FA enforcement, etc.)
model SystemParameter {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("system_parameter")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id                      String             @id @default(uuid())
  tenantId                String
  planId                  String
  provider                String
  externalSubscriptionId  String             @unique
  status                  SubscriptionStatus @default(TRIAL)
  pastDueSince            DateTime?
  currentPeriodEnd        DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  // Cobrança recorrente real (Cap. 2.7)
  paymentMethodToken      String?
  paymentMethodBrand      String?
  paymentMethodLast4      String?
  failedPaymentAttempts   Int                @default(0)
  nextRetryAt             DateTime?
  // Cancelamento e reembolso (Cap. 2.7.6)
  firstChargedAt          DateTime?
  cancelRequestedAt       DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  // Programa de Indicação (Cap. 2.8)
  creditBalanceMonths     Int                @default(0)
  firstCycleDiscountPercent Int?

  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                    Plan               @relation(fields: [planId], references: [id])
  billingEvents           BillingEvent[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

model BillingEvent {
  id               String       @id @default(uuid())
  subscriptionId   String
  provider         String
  externalEventKey String
  type             String
  payload          Json
  createdAt        DateTime     @default(now())

  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventKey])
  @@index([subscriptionId, createdAt])
  @@map("billing_events")
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY & RBAC — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  TECHNICIAN
  CASHIER
}

model User {
  id                    String    @id @default(uuid())
  tenantId              String
  name                  String
  email                 String
  passwordHash          String
  role                  UserRole
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // 2FA / Auth extras (Cap. 14)
  totpSecretEncrypted   String?
  totpConfirmedAt       DateTime?
  managerPinHash        String?
  preferredThemeMode    String    @default("light")
  // CRM / Comunicação
  phone                 String?

  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions       RolePermission[]
  sales                 Sale[]
  workOrders            WorkOrder[]  @relation("AssignedTechnician")
  cashRegisters         CashRegister[]
  osPhotos              OsPhoto[]
  appointments          Appointment[] @relation("AppointmentProfessional")
  backupCodes           TwoFactorBackupCode[]
  passwordResetTokens   PasswordResetToken[]
  activeSessions        ActiveSession[]
  auditLogs             AuditLog[]
  notifications         Notification[] @relation("UserNotifications")

  cashRegisterMovements      CashRegisterMovement[]
  purchaseOrdersCreated      PurchaseOrder[]
  inventoryCountsStarted     InventoryCount[] @relation("InventoryCountStartedBy")
  inventoryCountsApproved    InventoryCount[] @relation("InventoryCountApprovedBy")
  inventoryCountItems        InventoryCountItem[]
  reportDefinitionsCreated   ReportDefinition[]
  dashboardLayout            DashboardLayout?
  dataImportJobsCreated      DataImportJob[]
  ibsCbsRegimeElections      TenantIbsCbsRegimeElection[]
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

model RolePermission {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  permission String
  granted    Boolean  @default(true)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([tenantId, userId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
// PARTIES — CLIENTS & SUPPLIERS — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  document     String?
  phone        String?
  email        String?
  creditLimit  Decimal  @default(0) @db.Decimal(12, 2)
  creditBalanceUsed Decimal @default(0) @db.Decimal(12, 2)
  isBusinessAccount Boolean @default(false) // Cap. 11.8 — perfil construtora/empreiteiro
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales        Sale[]
  workOrders   WorkOrder[]
  containerLedgerEntries ReturnableContainerLedger[]
  accountsReceivable AccountReceivable[]
  pets         Pet[]
  vehicles     Vehicle[]
  opticalPrescriptions OpticalPrescription[]
  clientPackages ClientServicePackage[]
  comandas     Comanda[]
  appointments Appointment[]
  consignedListings VehicleListing[]
  serviceContracts ServiceContract[]

  @@unique([tenantId, document])
  @@index([tenantId, name])
  @@map("clients")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  accountsPayable AccountPayable[]

  purchaseOrders             PurchaseOrder[]
  @@unique([tenantId, document])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────
// PRODUCT CATALOG — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum ProductTrackingType {
  NONE
  BATCH
  SERIAL
  VARIANT
}

enum ProductSaleUnit {
  UNIT
  KG
  METER
  SQUARE_METER
  CUBIC_METER
  LITER
}

model Product {
  id                    String              @id @default(uuid())
  tenantId              String
  supplierId            String?
  sku                   String
  barcode               String?
  name                  String
  description           String?
  category              String?
  trackingType          ProductTrackingType @default(NONE)
  unitPrice             Decimal             @db.Decimal(12, 2)
  wholesalePrice        Decimal?            @db.Decimal(12, 2)
  resalePrice           Decimal?            @db.Decimal(12, 2)
  wholesaleMinQty       Int?
  stockQuantity         Decimal             @default(0) @db.Decimal(12, 3)
  minStockThreshold     Decimal?            @db.Decimal(12, 3)
  isWeighted            Boolean             @default(false)
  isReturnableContainer Boolean             @default(false)
  isReturnable          Boolean             @default(true)
  requiresPrescriptionRetention Boolean     @default(false)
  isControlledSubstance Boolean             @default(false)
  // Cap. 12 — venda fracionada (Material de Construção, Petshop granel, kits Papelaria)
  saleUnit              ProductSaleUnit     @default(UNIT)
  purchaseUnit          String?
  unitConversionFactor  Decimal?            @db.Decimal(12, 4)
  isKitComposition      Boolean             @default(false)
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier              Supplier?           @relation(fields: [supplierId], references: [id])
  batches               ProductBatch[]
  serials               ProductSerial[]
  variantAxes           ProductVariantAxis[]
  variants              ProductVariant[]
  recipe                Recipe?
  recipeUsages          RecipeItem[]        @relation("RecipeIngredient")
  saleItems             SaleItem[]
  workOrderItems        WorkOrderItem[]
  stockMovements        StockMovement[]
  productionBatchOutputs ProductionBatch[]  @relation("ProductionOutput")
  comandaItems          ComandaItem[]

  purchaseOrderItems         PurchaseOrderItem[]
  inventoryCountItems        InventoryCountItem[]
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, category])
  @@index([tenantId, active])
  @@map("products")
}

model ProductBatch {
  id                String   @id @default(uuid())
  tenantId          String
  productId         String
  batchNumber       String
  manufacturingDate DateTime?
  expirationDate    DateTime
  quantity          Decimal  @db.Decimal(12, 3)
  receivedAt        DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]

  inventoryCountItems        InventoryCountItem[]
  @@unique([tenantId, productId, batchNumber])
  @@index([tenantId, productId, expirationDate])
  @@map("product_batches")
}

model ProductSerial {
  id           String     @id @default(uuid())
  tenantId     String
  productId    String
  serialNumber String
  imei         String?
  status       String     @default("IN_STOCK")
  workOrderId  String?
  createdAt    DateTime   @default(now())

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@unique([tenantId, serialNumber])
  @@index([tenantId, imei])
  @@map("product_serials")
}

model ProductVariantAxis {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  name      String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@unique([tenantId, productId, name])
  @@map("product_variant_axes")
}

model ProductVariant {
  id            String             @id @default(uuid())
  tenantId      String
  productId     String
  axisId        String
  axisValue     String
  barcode       String?
  stockQuantity Decimal            @default(0) @db.Decimal(12, 3)
  priceOverride Decimal?           @db.Decimal(12, 2)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  axis          ProductVariantAxis @relation(fields: [axisId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]

  @@unique([tenantId, productId, axisValue])
  @@unique([tenantId, barcode])
  @@map("product_variants")
}

model PrescriptionRecord {
  id                 String   @id @default(uuid())
  tenantId           String
  saleItemId         String   @unique
  prescriptionType   String
  electronicPrescriptionNumber String?
  retainedDocumentStorageKey String?
  patientDocument    String
  validatedByUserId  String
  createdAt          DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("prescription_records")
}

// ─────────────────────────────────────────────────────────────────────────
// FICHA TÉCNICA / BOM E PRODUÇÃO — PADARIA — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

model Recipe {
  id            String       @id @default(uuid())
  tenantId      String
  productId     String       @unique
  yieldQuantity Decimal      @db.Decimal(12, 3)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items         RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id               String  @id @default(uuid())
  tenantId         String
  recipeId         String
  ingredientId     String
  quantityPerYield Decimal @db.Decimal(12, 4)

  recipe           Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient       Product @relation("RecipeIngredient", fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_items")
}

enum ProductionBatchStatus {
  PLANNED
  PRODUCED
  PARTIALLY_LOST
}

model ProductionBatch {
  id              String                 @id @default(uuid())
  tenantId        String
  finishedProductId String
  quantityProduced Decimal               @db.Decimal(12, 3)
  quantityLost    Decimal                @default(0) @db.Decimal(12, 3)
  status          ProductionBatchStatus  @default(PLANNED)
  producedByUserId String
  producedAt      DateTime               @default(now())

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finishedProduct Product                @relation("ProductionOutput", fields: [finishedProductId], references: [id])

  @@index([tenantId, finishedProductId, producedAt])
  @@map("production_batches")
}

// ─────────────────────────────────────────────────────────────────────────
// ADEGA — CASCOS/VASILHAMES RETORNÁVEIS — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum ContainerLedgerDirection {
  BORROWED
  RETURNED
}

model ReturnableContainerLedger {
  id        String                   @id @default(uuid())
  tenantId  String
  clientId  String
  productId String
  direction ContainerLedgerDirection
  quantity  Int
  saleId    String?
  createdAt DateTime                 @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, productId])
  @@map("returnable_container_ledger")
}

// ─────────────────────────────────────────────────────────────────────────
// ASSISTÊNCIA TÉCNICA — ORDENS DE SERVIÇO — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum WorkOrderStatus {
  RECEIVED
  DIAGNOSING
  AWAITING_APPROVAL
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
}

model WorkOrder {
  id                   String          @id @default(uuid())
  tenantId             String
  clientId             String
  assignedTechnicianId String?
  equipmentDescription String
  reportedIssue        String
  status               WorkOrderStatus @default(RECEIVED)
  diagnosisNotes       String?
  budgetValidUntil     DateTime?
  budgetApprovalToken  String?   @unique
  budgetApprovedAt     DateTime?
  warrantyDays         Int?
  warrantyExclusions   String?
  vehicleId            String?
  deliveredAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTechnician   User?           @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])
  vehicle              Vehicle?        @relation(fields: [vehicleId], references: [id])
  items                WorkOrderItem[]
  checklist            OsChecklist[]
  photos               OsPhoto[]
  productSerials       ProductSerial[]

  @@index([tenantId, status])
  @@index([tenantId, assignedTechnicianId])
  @@map("work_orders")
}

model WorkOrderItem {
  id            String    @id @default(uuid())
  tenantId      String
  workOrderId   String
  productId     String?
  description   String
  itemType      String
  quantity      Decimal   @db.Decimal(12, 3)
  unitPrice     Decimal   @db.Decimal(12, 2)
  commissionable Boolean  @default(false)

  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product       Product?  @relation(fields: [productId], references: [id])

  @@index([tenantId, workOrderId])
  @@map("work_order_items")
}

enum ChecklistStage {
  ENTRY
  DIAGNOSIS
  DELIVERY
}

model OsChecklist {
  id                 String         @id @default(uuid())
  tenantId           String
  workOrderId        String
  stage              ChecklistStage
  items              Json
  clientSignatureUrl String?
  createdAt          DateTime       @default(now())

  workOrder          WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, workOrderId, stage])
  @@map("os_checklists")
}

model OsPhoto {
  id           String   @id @default(uuid())
  tenantId     String
  workOrderId  String
  uploadedById String
  storageKey   String
  caption      String?
  createdAt    DateTime @default(now())

  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, workOrderId])
  @@map("os_photos")
}

// ─────────────────────────────────────────────────────────────────────────
// VENDAS, CAIXA E ESTOQUE — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum SaleStatus {
  OPEN
  PAID
  CANCELLED
  REFUNDED
}

enum SalePaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  BOLETO
  STORE_CREDIT
}

model Sale {
  id             String      @id @default(uuid())
  tenantId       String
  clientId       String?
  cashierId      String
  cashRegisterId String
  status         SaleStatus  @default(OPEN)
  idempotencyKey String
  paymentMethod  SalePaymentMethod
  totalAmount    Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  channel        String      @default("COUNTER") // DINE_IN | COUNTER | DELIVERY (Cap. 11.1)
  chartOfAccountId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client?      @relation(fields: [clientId], references: [id])
  cashier         User         @relation(fields: [cashierId], references: [id])
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id])
  items           SaleItem[]
  payments        Payment[]
  fiscalDocuments FiscalDocument[]
  accountsReceivable AccountReceivable[]
  comanda         Comanda?

  account                    ChartOfAccount? @relation(fields: [chartOfAccountId], references: [id], map: "sales_chart_of_account_fkey")

  @@unique([tenantId, idempotencyKey])
  @@index([chartOfAccountId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, cashRegisterId])
  @@map("sales")
}

model SaleItem {
  id               String          @id @default(uuid())
  tenantId         String
  saleId           String
  productId        String
  productVariantId String?
  quantity         Decimal         @db.Decimal(12, 3)
  unitPrice        Decimal         @db.Decimal(12, 2)
  totalPrice       Decimal         @db.Decimal(12, 2)

  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model Payment {
  id                   String        @id @default(uuid())
  tenantId             String
  saleId               String
  method               SalePaymentMethod
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(12, 2)
  tefAuthorizationCode String?
  idempotencyKey       String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sale                 Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId, status])
  @@map("payments")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id            String             @id @default(uuid())
  tenantId      String
  openedById    String
  status        CashRegisterStatus @default(OPEN)
  openingAmount Decimal            @db.Decimal(12, 2)
  closingAmount Decimal?           @db.Decimal(12, 2)
  expectedAmount Decimal?          @db.Decimal(12, 2)
  divergenceAmount Decimal?        @db.Decimal(12, 2)
  openedAt      DateTime           @default(now())
  closedAt      DateTime?

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy      User               @relation(fields: [openedById], references: [id])
  sales         Sale[]

  movements                  CashRegisterMovement[]
  @@index([tenantId, status])
  @@map("cash_registers")
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RECIPE_CONSUMPTION
  PRODUCTION_CONSUMPTION
  LOSS
  RETURN
}

model StockMovement {
  id             String             @id @default(uuid())
  tenantId       String
  productId      String
  productBatchId String?
  type           StockMovementType
  quantity       Decimal            @db.Decimal(12, 3)
  reasonCode     String?
  referenceId    String?
  createdAt      DateTime           @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [productId], references: [id])
  productBatch   ProductBatch?      @relation(fields: [productBatchId], references: [id])

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, type])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────
// FINANCEIRO — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum PayableStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model AccountPayable {
  id            String        @id @default(uuid())
  tenantId      String
  supplierId    String
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  status        PayableStatus @default(PENDING)
  paidAt        DateTime?
  sourceNfeKey  String?
  accountId     String?
  costCenterId  String?
  purchaseOrderId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id])

  account                    ChartOfAccount? @relation(fields: [accountId], references: [id], map: "accounts_payable_account_fkey")
  costCenter                 CostCenter? @relation(fields: [costCenterId], references: [id], map: "accounts_payable_cost_center_fkey")
  purchaseOrder              PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], map: "accounts_payable_purchase_order_fkey")

  @@index([accountId])
  @@index([costCenterId])
  @@index([purchaseOrderId])
  @@index([tenantId, status, dueDate])
  @@map("accounts_payable")
}

enum ReceivableStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model AccountReceivable {
  id          String           @id @default(uuid())
  tenantId    String
  clientId    String
  saleId      String?
  description String
  amount      Decimal          @db.Decimal(12, 2)
  dueDate     DateTime
  status      ReceivableStatus @default(PENDING)
  paidAt      DateTime?
  accountId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId], references: [id])
  sale        Sale?            @relation(fields: [saleId], references: [id])

  account                    ChartOfAccount? @relation(fields: [accountId], references: [id], map: "accounts_receivable_account_fkey")

  @@index([accountId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, clientId])
  @@map("accounts_receivable")
}

// ─────────────────────────────────────────────────────────────────────────
// DOCUMENTOS FISCAIS — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum FiscalDocumentType {
  NFCE
  NFE_SAIDA
  NFE_ENTRADA
}

enum FiscalDocumentStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELLED
}

model FiscalDocument {
  id              String                @id @default(uuid())
  tenantId        String
  saleId          String?
  type            FiscalDocumentType
  status          FiscalDocumentStatus  @default(PENDING)
  accessKey       String?               @unique
  xmlStorageKey   String?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale            Sale?                 @relation(fields: [saleId], references: [id], onDelete: Cascade)

  events                     FiscalDocumentEvent[]
  @@index([tenantId, status])
  @@index([tenantId, saleId])
  @@map("fiscal_documents")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — SERVIÇOS E AGENDAMENTO (Petshop, Salão, Estética, Oficina)
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id                     String   @id @default(uuid())
  tenantId               String
  name                   String
  nicheTag               String
  basePrice              Decimal  @db.Decimal(12, 2)
  estimatedDurationMinutes Int
  commissionPercentage   Decimal  @db.Decimal(5, 2) @default(0)
  active                 Boolean  @default(true)

  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments           Appointment[]
  clientPackages         ClientServicePackage[]
  contractItems          ServiceContractItem[]

  @@index([tenantId, nicheTag])
  @@map("services")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  clientId        String
  serviceId       String
  professionalId  String
  petId           String?
  vehicleId       String?
  scheduledAt     DateTime
  durationMinutes Int
  status          AppointmentStatus @default(SCHEDULED)
  comandaId       String?
  createdAt       DateTime          @default(now())

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id])
  professional    User              @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  pet             Pet?              @relation(fields: [petId], references: [id])
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id])

  @@unique([tenantId, professionalId, scheduledAt])
  @@index([tenantId, clientId])
  @@map("appointments")
}

model ClientServicePackage {
  id               String   @id @default(uuid())
  tenantId         String
  clientId         String
  serviceId        String
  totalSessions    Int
  sessionsUsed     Int      @default(0)
  purchasedAt      DateTime @default(now())
  expiresAt        DateTime?

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service          Service  @relation(fields: [serviceId], references: [id])

  @@index([tenantId, clientId, serviceId])
  @@map("client_service_packages")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — COMANDA ELETRÔNICA (Restaurante, Salão)
// ─────────────────────────────────────────────────────────────────────────

model RestaurantTable {
  id        String  @id @default(uuid())
  tenantId  String
  label     String
  seatCount Int
  active    Boolean @default(true)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comandas  Comanda[]

  @@unique([tenantId, label])
  @@map("restaurant_tables")
}

enum ComandaStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Comanda {
  id        String        @id @default(uuid())
  tenantId  String
  tableId   String?
  clientId  String?
  status    ComandaStatus @default(OPEN)
  saleId    String?       @unique
  openedAt  DateTime      @default(now())
  closedAt  DateTime?

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table     RestaurantTable? @relation(fields: [tableId], references: [id])
  client    Client?          @relation(fields: [clientId], references: [id])
  sale      Sale?            @relation(fields: [saleId], references: [id])
  items     ComandaItem[]

  @@index([tenantId, status])
  @@map("comandas")
}

model ComandaItem {
  id         String  @id @default(uuid())
  tenantId   String
  comandaId  String
  productId  String?
  serviceId  String?
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(12, 2)
  sentToKdsAt DateTime?

  comanda    Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])

  @@index([tenantId, comandaId])
  @@map("comanda_items")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — ÓTICA
// ─────────────────────────────────────────────────────────────────────────

model OpticalPrescription {
  id                String   @id @default(uuid())
  tenantId          String
  clientId          String
  prescribingDoctor String
  rightEyeSphere    Decimal  @db.Decimal(4, 2)
  rightEyeCylinder  Decimal  @db.Decimal(4, 2)
  rightEyeAxis      Int
  leftEyeSphere     Decimal  @db.Decimal(4, 2)
  leftEyeCylinder   Decimal  @db.Decimal(4, 2)
  leftEyeAxis       Int
  addition          Decimal? @db.Decimal(4, 2)
  pupillaryDistance Decimal? @db.Decimal(4, 1)
  registeredAt      DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@map("optical_prescriptions")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — PETSHOP/VETERINÁRIA
// ─────────────────────────────────────────────────────────────────────────

model Pet {
  id          String   @id @default(uuid())
  tenantId    String
  ownerId     String
  name        String
  species     String
  breed       String?
  birthDate   DateTime?
  weightKg    Decimal? @db.Decimal(6, 2)
  createdAt   DateTime @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       Client          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vaccineRecords VaccineRecord[]
  appointments   Appointment[]

  @@index([tenantId, ownerId])
  @@map("pets")
}

model VaccineRecord {
  id            String   @id @default(uuid())
  tenantId      String
  petId         String
  vaccineName   String
  appliedAt     DateTime
  nextDoseDueAt DateTime?
  appliedByUserId String

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet           Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([tenantId, petId, nextDoseDueAt])
  @@map("vaccine_records")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — SETOR AUTOMOTIVO
// ─────────────────────────────────────────────────────────────────────────

model Vehicle {
  id           String   @id @default(uuid())
  tenantId     String
  ownerId      String
  licensePlate String
  chassisNumber String?
  model        String
  manufactureYear Int?
  mileageKm    Int?
  createdAt    DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner        Client        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workOrders   WorkOrder[]
  appointments Appointment[]

  @@unique([tenantId, licensePlate])
  @@index([tenantId, ownerId])
  @@map("vehicles")
}

enum VehicleListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  CONSIGNED
}

model VehicleListing {
  id                  String               @id @default(uuid())
  tenantId            String
  chassisNumber       String
  licensePlate        String?
  model               String
  manufactureYear     Int
  mileageKm           Int
  askingPrice         Decimal              @db.Decimal(12, 2)
  status              VehicleListingStatus @default(AVAILABLE)
  consignorClientId   String?
  consignmentCommissionPercentage Decimal? @db.Decimal(5, 2)
  atpveDocumentStorageKey String?
  soldAt              DateTime?
  createdAt           DateTime             @default(now())

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consignorClient     Client?  @relation(fields: [consignorClientId], references: [id])

  @@unique([tenantId, chassisNumber])
  @@index([tenantId, status])
  @@map("vehicle_listings")
}

// ─────────────────────────────────────────────────────────────────────────
// CONTRATO DE SERVIÇO — emissão de contrato formal entre tenant e cliente
// ─────────────────────────────────────────────────────────────────────────

enum ContractStatus {
  DRAFT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model ServiceContract {
  id              String        @id @default(uuid())
  tenantId        String
  clientId        String
  contractNumber  String        @unique
  title           String
  description     String?
  status          ContractStatus @default(DRAFT)
  totalAmount     Decimal       @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  signedAt        DateTime?
  pdfStorageKey   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items           ServiceContractItem[]

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@map("service_contracts")
}

model ServiceContractItem {
  id              String   @id @default(uuid())
  tenantId        String
  contractId      String
  serviceId       String?
  description     String
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)

  contract        ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service         Service?   @relation(fields: [serviceId], references: [id])

  @@index([tenantId, contractId])
  @@map("service_contract_items")
}

// ─────────────────────────────────────────────────────────────────────────
// COMISSÃO DE TÉCNICO — registro financeiro de comissão por O.S.
// ─────────────────────────────────────────────────────────────────────────

model TechnicianCommission {
  id              String   @id @default(uuid())
  tenantId        String
  workOrderId     String
  technicianId    String
  baseAmount      Decimal  @db.Decimal(12, 2)
  percentage      Decimal  @db.Decimal(5, 2)
  amount          Decimal  @db.Decimal(12, 2)
  releasedAt      DateTime @default(now())

  @@unique([tenantId, workOrderId])
  @@index([tenantId, technicianId])
  @@map("technician_commissions")
}

// ─────────────────────────────────────────────────────────────────────────
// AUDIT LOG — imutável (apenas append)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "tenant_audit_logs")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_audit_logs")

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICAÇÕES CENTRAIS — multi-canal (in-app, e-mail, push, WhatsApp, SMS)
// ─────────────────────────────────────────────────────────────────────────

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id           String               @id @default(uuid())
  tenantId     String
  recipientId  String               // userId ou tenantId
  category     String
  title        String
  body         String
  priority     NotificationPriority @default(NORMAL)
  data         Json?
  actionUrl    String?
  readAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "tenant_notifications")
  recipient    User?    @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([tenantId, recipientId, readAt])
  @@index([tenantId, category])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  enabledChannels String[] @default(["IN_APP"])
  whatsappOptIn   Boolean  @default(false)
  emailOptIn      Boolean  @default(true)
  pushOptIn       Boolean  @default(true)
  smsOptIn        Boolean  @default(false)
  quietHoursStart String?  // HH:MM
  quietHoursEnd   String?  // HH:MM
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_preferences")
}

model PushDeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  String   // "ios" | "android" | "web"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId, active])
  @@map("push_device_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// 2FA / AUTH EXTRAS
// ─────────────────────────────────────────────────────────────────────────

model TwoFactorBackupCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("two_factor_backup_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model ActiveSession {
  id            String   @id @default(uuid())
  userId        String
  sessionId     String   @unique
  ipAddress     String?
  userAgent     String?
  lastActivity  DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("active_sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// FIDELIDADE (Cap. 4.1.1)
// ─────────────────────────────────────────────────────────────────────────

model LoyaltyProgram {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  active                 Boolean  @default(false)
  pointsPerCurrencyUnit  Decimal  @default(1) @db.Decimal(6, 2)
  redemptionValuePerPoint Decimal  @default(0.01) @db.Decimal(6, 4)
  minPointsToRedeem      Int      @default(100)
  pointsExpireAfterDays  Int?
  updatedAt              DateTime @updatedAt

  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "tenant_loyalty_program")

  @@map("loyalty_programs")
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  MANUAL_ADJUST
}

model LoyaltyAccount {
  id            String   @id @default(uuid())
  tenantId      String
  clientId      String   @unique
  pointsBalance Int      @default(0)
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "tenant_loyalty_accounts")

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String                 @id @default(uuid())
  loyaltyAccountId String
  type             LoyaltyTransactionType
  points           Int
  saleId           String?
  expiresAt        DateTime?
  reason           String?
  createdAt        DateTime               @default(now())

  @@index([loyaltyAccountId, createdAt])
  @@index([expiresAt])
  @@map("loyalty_transactions")
}

// ─────────────────────────────────────────────────────────────────────────
// PROGRAMA DE INDICAÇÃO (Cap. 2.8)
// ─────────────────────────────────────────────────────────────────────────

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}

model Referral {
  id               String         @id @default(uuid())
  referralCodeId   String
  referredTenantId String         @unique
  status           ReferralStatus @default(PENDING)
  rewardAppliedAt  DateTime?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())

  referralCode     ReferralCode   @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referredTenant   Tenant         @relation("ReferredTenant", fields: [referredTenantId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("referrals")
}

model ReferralCode {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "tenant_referral_code")
  referrals Referral[]

  @@map("referral_codes")
}

// ─────────────────────────────────────────────────────────────────────────
// VITRINE VIRTUAL (Loja Online do Tenant) — Cap. 8.5
// ─────────────────────────────────────────────────────────────────────────

model OnlineStoreSettings {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  isActive        Boolean  @default(false)
  customSlug      String   @unique // subdomínio público
  primaryColorHex String   @default("#4F46E5")
  logoStorageKey  String?
  deliveryEnabled Boolean  @default(false)
  deliveryFee     Decimal? @db.Decimal(10, 2)
  minOrderAmount  Decimal? @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("online_store_settings")
}

// ─────────────────────────────────────────────────────────────────────────
// EVENTOS FISCAIS PÓS-EMISSÃO: Cancelamento, Carta de Correção, Manifestação do Destinatário — Cap. 21.19
// ─────────────────────────────────────────────────────────────────────────

enum FiscalDocumentEventType {
  CANCELLATION
  CORRECTION_LETTER
  RECIPIENT_MANIFESTATION
}

enum RecipientManifestationType {
  CONFIRMACAO_DA_OPERACAO
  OPERACAO_NAO_REALIZADA
  DESCONHECIMENTO_DA_OPERACAO
  CIENCIA_DA_OPERACAO
}

model FiscalDocumentEvent {
  id                String                      @id @default(uuid())
  tenantId          String
  fiscalDocumentId  String
  eventType         FiscalDocumentEventType
  sequenceNumber    Int
  justification     String?
  manifestationType RecipientManifestationType?
  protocolNumber    String?
  eventXmlStorageKey String?
  status            FiscalDocumentStatus         @default(PENDING)
  rejectionReason   String?
  createdAt         DateTime                    @default(now())

  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalDocument    FiscalDocument              @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  @@unique([fiscalDocumentId, eventType, sequenceNumber])
  @@index([tenantId, fiscalDocumentId])
  @@map("fiscal_document_events")
}

// ─────────────────────────────────────────────────────────────────────────
// SANGRIA E SUPRIMENTO DE CAIXA — Cap. 6.7
// ─────────────────────────────────────────────────────────────────────────

enum CashRegisterMovementType {
  WITHDRAWAL
  INJECTION
}

model CashRegisterMovement {
  id              String                   @id @default(uuid())
  cashRegisterId  String
  type            CashRegisterMovementType
  amount          Decimal                  @db.Decimal(12, 2)
  reason          String
  performedByUserId String
  createdAt       DateTime                 @default(now())

  cashRegister    CashRegister             @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  performedBy     User                     @relation(fields: [performedByUserId], references: [id])

  @@index([cashRegisterId, createdAt])
  @@map("cash_register_movements")
}

// ─────────────────────────────────────────────────────────────────────────
// COBRANÇA: BOLETO E PIX — Cap. 17.5
// ─────────────────────────────────────────────────────────────────────────

enum ChargeType {
  BOLETO
  PIX
}

enum ChargeStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model PaymentCharge {
  id              String       @id @default(uuid())
  tenantId        String
  accountReceivableId String   @unique
  type            ChargeType
  status          ChargeStatus @default(PENDING)
  pixQrCodePayload String?     // payload EMV do QR Code Pix dinâmico
  boletoDigitableLine String?  // linha digitável, quando aplicável
  boletoPdfStorageKey String?
  expiresAt       DateTime
  paidAt          DateTime?
  externalProviderId String?   // ID da cobrança no PSP (ex.: Asaas, Efí, Mercado Pago)
  createdAt       DateTime    @default(now())

  @@index([tenantId, status])
  @@map("payment_charges")
}

// ─────────────────────────────────────────────────────────────────────────
// PLANO DE CONTAS E CENTRO DE CUSTO — Cap. 17.1
// ─────────────────────────────────────────────────────────────────────────

enum AccountNature {
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id          String        @id @default(uuid())
  tenantId    String
  code        String        // ex.: "3.1.01" — estrutura hierárquica por código
  name        String
  nature      AccountNature
  parentId    String?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      ChartOfAccount?   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[]  @relation("AccountHierarchy")
  costCenters CostCenter[]
  sales       Sale[]
  accountsPayable    AccountPayable[]
  accountsReceivable AccountReceivable[]

  @@unique([tenantId, code])
  @@map("chart_of_accounts")
}

model CostCenter {
  id        String  @id @default(uuid())
  tenantId  String
  accountId String
  code      String? // identificador técnico estável (ex.: "FOLHA_PAGAMENTO"), distinto de `name`
  name      String

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account        ChartOfAccount   @relation(fields: [accountId], references: [id])
  accountsPayable AccountPayable[]

  @@unique([tenantId, code])
  @@map("cost_centers")
}

// ─────────────────────────────────────────────────────────────────────────
// MÓDULO DE COMPRAS — Pedido de Compra, Recebimento e Sugestão de Reposição — Cap. 17.8
// ─────────────────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEVED
  CANCELLED
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  tenantId      String
  supplierId    String
  status        PurchaseOrderStatus @default(DRAFT)
  orderNumber   Int                 // sequencial por tenant, exibido ao fornecedor (ex.: "Pedido #142")
  expectedAt    DateTime?
  notes         String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  createdBy     User                @relation(fields: [createdById], references: [id])
  items         PurchaseOrderItem[]
  accountsPayable AccountPayable[]  // gerado automaticamente no recebimento (17.8.2)

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  tenantId         String
  purchaseOrderId  String
  productId        String
  quantityOrdered  Decimal       @db.Decimal(12, 3)
  quantityReceived Decimal       @db.Decimal(12, 3) @default(0)
  unitCost         Decimal       @db.Decimal(12, 4)
  batchNumber      String?
  expirationDate   DateTime?

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────────────────────────────────
// CONTAGEM FÍSICA DE ESTOQUE (INVENTÁRIO/BALANÇO) E RECONCILIAÇÃO — Cap. 17.9
// ─────────────────────────────────────────────────────────────────────────

enum InventoryCountStatus {
  OPEN
  RECONCILING
  APPROVED
  CANCELLED
}

model InventoryCount {
  id            String                @id @default(uuid())
  tenantId      String
  code          String                // sequencial amigável, ex.: "INV-2025-014"
  status        InventoryCountStatus  @default(OPEN)
  scope         String                // "FULL" (balanço geral) ou "CATEGORY:{categoryId}" ou "LOCATION:{storageLocationId}"
  startedAt     DateTime              @default(now())
  startedByUserId String
  approvedAt    DateTime?
  approvedByUserId String?
  notes         String?

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedBy     User                  @relation("InventoryCountStartedBy", fields: [startedByUserId], references: [id])
  approvedBy    User?                 @relation("InventoryCountApprovedBy", fields: [approvedByUserId], references: [id])
  items         InventoryCountItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id                String          @id @default(uuid())
  inventoryCountId  String
  productId         String
  productBatchId    String?         // em produtos com lote (Farmácia, Padaria), a contagem é por lote
  expectedQuantity  Decimal         @db.Decimal(14, 3) // saldo teórico no momento em que a contagem deste item foi iniciada (snapshot)
  countedQuantity   Decimal?        @db.Decimal(14, 3) // preenchido pelo operador com leitor de código de barras em campo
  countedAt         DateTime?
  countedByUserId   String?
  divergenceReason  String?         // obrigatório quando |counted - expected| > 0, nunca opcional (auditoria exige motivo)

  inventoryCount    InventoryCount  @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  productBatch      ProductBatch?   @relation(fields: [productBatchId], references: [id])
  countedBy         User?           @relation(fields: [countedByUserId], references: [id])

  @@unique([inventoryCountId, productId, productBatchId])
  @@index([inventoryCountId])
  @@map("inventory_count_items")
}

// ─────────────────────────────────────────────────────────────────────────
// RELATÓRIOS, BI E PORTABILIDADE DE DADOS — Cap. 18
// ─────────────────────────────────────────────────────────────────────────

model ReportDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  createdByUserId String
  name        String
  datasetKey  String  // ex.: "sales", "stock_movements", "work_orders" — fonte pré-aprovada
  dimensions  Json    // ex.: ["product.category", "createdAt.month"]
  metrics     Json    // ex.: ["sum(totalAmount)", "count(*)"]
  filters     Json
  chartType   String  // "TABLE" | "BAR" | "LINE" | "PIE"
  isPinnedToDashboard Boolean @default(false)
  createdAt   DateTime @default(now())

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdByUserId], references: [id])
  scheduledReports ScheduledReport[]

  @@index([tenantId, isPinnedToDashboard])
  @@map("report_definitions")
}

model ScheduledReport {
  id               String   @id @default(uuid())
  tenantId         String
  reportDefinitionId String
  cronExpression   String // ex.: "0 8 * * 1" (toda segunda às 8h)
  recipientEmails  String[]
  format           String // "PDF" | "XLSX"
  active           Boolean  @default(true)
  lastRunAt        DateTime?
  createdAt        DateTime @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("scheduled_reports")
}

model DashboardLayout {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String   @unique // um layout por usuário — não compartilhado entre papéis
  widgets   Json     // array ordenado de { reportDefinitionId, x, y, w, h }
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("dashboard_layouts")
}

// ─────────────────────────────────────────────────────────────────────────
// IMPORTAÇÃO ASSISTIDA DE DADOS (Migração de Onboarding) — Cap. 18.5
// ─────────────────────────────────────────────────────────────────────────

enum DataImportStatus {
  UPLOADED
  VALIDATING
  VALIDATED_WITH_ERRORS
  VALIDATED_CLEAN
  IMPORTING
  COMPLETED
  FAILED
}

model DataImportJob {
  id             String            @id @default(uuid())
  tenantId       String
  targetEntity   String            // "PRODUCT" | "CLIENT" | "SUPPLIER" — extensível
  status         DataImportStatus  @default(UPLOADED)
  sourceFileKey  String            // chave do arquivo original no Cloudflare R2
  columnMapping  Json              // { "Preço Venda": "unitPrice", "Cod Barras": "barcodeEan13", ... }
  totalRows      Int               @default(0)
  processedRows  Int               @default(0)
  errorReportKey String?           // CSV de erros gerado pela etapa de validação, também em R2
  createdByUserId String
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy      User              @relation(fields: [createdByUserId], references: [id])

  @@index([tenantId, status])
  @@map("data_import_jobs")
}

// ─────────────────────────────────────────────────────────────────────────
// INTEGRAÇÕES EXTERNAS — Credenciais e Health Checks — Cap. 20
// ─────────────────────────────────────────────────────────────────────────

enum IntegrationProvider {
  WHATSAPP_META_CLOUD
  FISCAL_FOCUS_NFE
  BILLING_ASAAS
  BILLING_STRIPE
  STORAGE_CLOUDFLARE_R2
  EMAIL_RESEND
  SMS_ZENVIA
  TEF_CLISITEF
  VEHICLE_DATA_FIPE_PLACA
  BANK_OPEN_FINANCE_PLUGGY
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

model IntegrationCredential {
  id                String                 @id @default(uuid())
  tenantId          String?
  provider          IntegrationProvider
  environment       IntegrationEnvironment @default(PRODUCTION)
  encryptedPayload  Bytes
  encryptionKeyId   String
  active            Boolean                @default(true)
  lastTestedAt      DateTime?
  lastTestSuccess   Boolean?
  lastTestMessage   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([tenantId, provider, environment])
  @@index([provider, active])
  @@map("integration_credentials")
}

model IntegrationHealthCheckLog {
  id            String   @id @default(uuid())
  credentialId  String
  success       Boolean
  httpStatus    Int?
  latencyMs     Int
  responseBody  String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([credentialId, createdAt])
  @@map("integration_health_check_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// MOTOR FISCAL — TaxRule, Catálogo de Códigos Fiscais — Cap. 21
// ─────────────────────────────────────────────────────────────────────────

model TaxRule {
  id              String   @id @default(uuid())
  tenantId        String?
  nicheCode       String?
  uf              String?
  ncm             String?
  nbs             String?
  cest            String?
  cfop            String?
  cstCsosn        String?
  icmsAliquota    Decimal?  @db.Decimal(5, 2)
  icmsInterestadualAliquota Decimal? @db.Decimal(5, 2)
  icmsStMva       Decimal?  @db.Decimal(5, 2)
  icmsBaseReductionPercent Decimal? @db.Decimal(5, 2)
  issAliquota     Decimal?  @db.Decimal(5, 2)
  issRetidoNaFonte Boolean  @default(false)
  pisCofinsRegime PisCofinsRegime @default(ISENTO_SIMPLES)
  pisAliquotaConcentrada Decimal? @db.Decimal(5, 4)
  cofinsAliquotaConcentrada Decimal? @db.Decimal(5, 4)
  ibsAliquota     Decimal?  @db.Decimal(5, 2)
  cbsAliquota     Decimal?  @db.Decimal(5, 2)
  selectiveTaxAliquota Decimal? @db.Decimal(5, 2)
  legalReference  String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([nicheCode, uf, effectiveFrom])
  @@index([tenantId])
  @@map("tax_rules")
}

enum PisCofinsRegime {
  ISENTO_SIMPLES
  CUMULATIVO
  NAO_CUMULATIVO
  MONOFASICO_CONCENTRADO
  MONOFASICO_ALIQUOTA_ZERO
}

enum FiscalCodeType {
  NCM
  NBS
  CEST
}

enum CatalogImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
}

model FiscalCodeCatalogImport {
  id                  String              @id @default(uuid())
  catalogType         FiscalCodeType
  sourceDescription   String
  fileName            String?
  importedByUserId     String
  totalCodesProcessed  Int
  status              CatalogImportStatus @default(PROCESSING)
  errorLog            String?             @db.Text
  createdAt           DateTime            @default(now())

  codes               FiscalCode[]

  @@index([catalogType, createdAt])
  @@map("fiscal_code_catalog_imports")
}

model FiscalCode {
  id              String         @id @default(uuid())
  catalogImportId String
  type            FiscalCodeType
  code            String
  description     String         @db.Text
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime       @default(now())

  catalogImport   FiscalCodeCatalogImport @relation(fields: [catalogImportId], references: [id])

  @@unique([type, code, effectiveFrom])
  @@index([type, code, effectiveTo])
  @@map("fiscal_codes")
}

// ─────────────────────────────────────────────────────────────────────────
// REFORMA TRIBUTÁRIA — TenantIbsCbsRegimeElection — Cap. 21.15
// ─────────────────────────────────────────────────────────────────────────

enum IbsCbsRegimeOptante {
  EMBUTIDO_NO_DAS
  REGULAR_COM_CREDITO
}

model TenantIbsCbsRegimeElection {
  id                 String              @id @default(uuid())
  tenantId           String
  regime             IbsCbsRegimeOptante
  semestreReferencia String
  janelaAbreEm       DateTime
  janelaFechaEm      DateTime
  eleitoEm           DateTime            @default(now())
  eleitoPorUserId    String

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eleitoPorUser       User               @relation(fields: [eleitoPorUserId], references: [id])

  @@unique([tenantId, semestreReferencia])
  @@index([tenantId, eleitoEm])
  @@map("tenant_ibs_cbs_regime_elections")
}

// ─────────────────────────────────────────────────────────────────────────
// LEIAUTES OFICIAIS VERSIONADOS (ECD/ECF/EFD-Reinf/DEFIS) — Cap. 21.18.7
// ─────────────────────────────────────────────────────────────────────────

model OfficialDocumentLayoutVersion {
  id                String                  @id @default(uuid())
  documentType      OfficialTaxDocumentType
  layoutVersion     String
  sourceDescription String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  createdAt         DateTime                @default(now())

  @@index([documentType, effectiveFrom])
  @@map("official_document_layout_versions")
}

enum OfficialTaxDocumentType {
  ECD
  ECF
  EFD_REINF
  DCTFWEB
  DEFIS
  DARF
  DAS
  IRPF_DECLARACAO
  INFORME_RENDIMENTOS_SOCIO
}

// ─────────────────────────────────────────────────────────────────────────
// ESCRITÓRIO DE CONTABILIDADE — Marketplace, Procuração, Tarefas, ECD/ECF — Cap. 21.18
// ─────────────────────────────────────────────────────────────────────────

enum AccountingEngagementScope {
  FULL_BOOKKEEPING
  TAX_FILING
  PAYROLL_ESOCIAL
  PERSONAL_INCOME_TAX
  DOCUMENT_EXPORT_ONLY
}

enum AccountingEngagementStatus {
  PENDING_ACCOUNTANT_ACCEPTANCE
  ACTIVE
  REVOKED_BY_CLIENT
  REVOKED_BY_ACCOUNTANT
  EXPIRED
}

enum AccountingEngagementEventType {
  GRANTED
  ACCEPTED
  REVOKED_BY_CLIENT
  REVOKED_BY_ACCOUNTANT
  EXPIRED
  SCOPE_CHANGED
  CROSS_TENANT_ACCESS
}

enum AccountingTaskType {
  ECD_GERACAO
  ECF_GERACAO
  EFD_REINF_ENVIO
  DCTFWEB_GERACAO
  DEFIS_ENVIO
  FOLHA_FECHAMENTO
  DAS_GERACAO
  DARF_GERACAO
  IRPF_DECLARACAO
}

enum AccountingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  LATE
  BLOCKED
}

enum OfficialTaxDocumentStatus {
  DRAFT
  GENERATED
  TRANSMITTED
  REJECTED
}

model AccountingFirmProfile {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique
  crcNumber                String
  responsibleAccountantName String
  responsibleAccountantCrc String
  bio                      String?  @db.Text
  servicesOffered          AccountingEngagementScope[]
  baseMonthlyFee           Decimal? @db.Decimal(10, 2)
  isListedInMarketplace    Boolean  @default(false)
  marketplaceRatingAverage Decimal  @default(0) @db.Decimal(2, 1)
  marketplaceRatingCount   Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("accounting_firm_profiles")
}

model AccountingEngagement {
  id                     String                      @id @default(uuid())
  accountingFirmTenantId String
  clientTenantId         String
  scopes                 AccountingEngagementScope[]
  status                 AccountingEngagementStatus  @default(PENDING_ACCOUNTANT_ACCEPTANCE)
  grantedByUserId        String
  grantedAt              DateTime                    @default(now())
  acceptanceDeadlineAt   DateTime
  acceptedByUserId       String?
  acceptedAt             DateTime?
  revokedByUserId        String?
  revokedAt              DateTime?
  revokedReason          String?

  firmTenant   Tenant                            @relation("EngagementsAsFirm", fields: [accountingFirmTenantId], references: [id], onDelete: Cascade)
  clientTenant Tenant                            @relation("EngagementsAsClient", fields: [clientTenantId], references: [id], onDelete: Cascade)
  auditEvents  AccountingEngagementAuditEvent[]
  fees         AccountingEngagementFee[]
  tasks        AccountingTask[]
  reviews      AccountingMarketplaceReview[]

  @@index([accountingFirmTenantId, status])
  @@index([clientTenantId, status])
  @@map("accounting_engagements")
}

model AccountingEngagementAuditEvent {
  id           String                          @id @default(uuid())
  engagementId String
  eventType    AccountingEngagementEventType
  actorUserId  String?
  occurredAt   DateTime                        @default(now())
  metadata     Json?

  engagement   AccountingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId, occurredAt])
  @@map("accounting_engagement_audit_events")
}

model AccountingEngagementFee {
  id                  String    @id @default(uuid())
  engagementId        String
  amount              Decimal   @db.Decimal(10, 2)
  periodicity         String    // "MONTHLY" | "ONE_TIME"
  dueDay              Int?
  accountReceivableId String?
  accountPayableId    String?
  createdAt           DateTime  @default(now())

  engagement          AccountingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("accounting_engagement_fees")
}

model AccountingTask {
  id                     String               @id @default(uuid())
  accountingFirmTenantId String
  clientTenantId         String
  engagementId           String?
  taskType               AccountingTaskType
  competencia            String
  dueDate                DateTime
  status                 AccountingTaskStatus @default(PENDING)
  assignedUserId         String?
  completedAt            DateTime?
  resultingDocumentId    String?

  firmTenant   Tenant                @relation("AccountingTasksAsFirm", fields: [accountingFirmTenantId], references: [id], onDelete: Cascade)
  clientTenant Tenant                @relation("AccountingTasksAsClient", fields: [clientTenantId], references: [id], onDelete: Cascade)
  engagement   AccountingEngagement? @relation(fields: [engagementId], references: [id])

  @@index([accountingFirmTenantId, status, dueDate])
  @@index([clientTenantId, competencia])
  @@map("accounting_tasks")
}

model OfficialTaxDocument {
  id                              String                    @id @default(uuid())
  tenantId                        String
  generatedByAccountingFirmTenantId String?
  documentType                    OfficialTaxDocumentType
  layoutVersion                   String
  competenciaInicio               DateTime
  competenciaFim                  DateTime
  fileUrl                         String
  transmissionProtocol            String?
  rejectionReason                 String?
  status                          OfficialTaxDocumentStatus @default(DRAFT)
  generatedAt                     DateTime                  @default(now())

  tenant           Tenant  @relation("OfficialTaxDocumentsOfTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  generatedByFirm  Tenant? @relation("OfficialTaxDocumentsGeneratedByFirm", fields: [generatedByAccountingFirmTenantId], references: [id])

  @@index([tenantId, documentType, competenciaInicio])
  @@map("official_tax_documents")
}

model AccountingMarketplaceReview {
  id                     String   @id @default(uuid())
  accountingFirmTenantId String
  clientTenantId         String
  engagementId           String
  authorUserId           String
  rating                 Int
  comment                String?  @db.Text
  createdAt              DateTime @default(now())

  engagement AccountingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, authorUserId])
  @@index([accountingFirmTenantId])
  @@map("accounting_marketplace_reviews")
}
