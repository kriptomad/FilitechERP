// ─────────────────────────────────────────────────────────────────────────
// ESCRITÓRIO DE CONTABILIDADE — Marketplace, Procuração, Tarefas, ECD/ECF — Cap. 21.18
// ─────────────────────────────────────────────────────────────────────────

enum AccountingEngagementScope {
  FULL_BOOKKEEPING
  TAX_FILING
  PAYROLL_ESOCIAL
  PERSONAL_INCOME_TAX
  DOCUMENT_EXPORT_ONLY
}

enum AccountingEngagementStatus {
  PENDING_ACCOUNTANT_ACCEPTANCE
  ACTIVE
  REVOKED_BY_CLIENT
  REVOKED_BY_ACCOUNTANT
  EXPIRED
}

enum AccountingEngagementEventType {
  GRANTED
  ACCEPTED
  REVOKED_BY_CLIENT
  REVOKED_BY_ACCOUNTANT
  EXPIRED
  SCOPE_CHANGED
  CROSS_TENANT_ACCESS
}

enum AccountingTaskType {
  ECD_GERACAO
  ECF_GERACAO
  EFD_REINF_ENVIO
  DCTFWEB_GERACAO
  DEFIS_ENVIO
  FOLHA_FECHAMENTO
  DAS_GERACAO
  DARF_GERACAO
  IRPF_DECLARACAO
}

enum AccountingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  LATE
  BLOCKED
}

enum OfficialTaxDocumentStatus {
  DRAFT
  GENERATED
  TRANSMITTED
  REJECTED
}

model AccountingFirmProfile {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique
  crcNumber                String
  responsibleAccountantName String
  responsibleAccountantCrc String
  bio                      String?  @db.Text
  servicesOffered          AccountingEngagementScope[]
  baseMonthlyFee           Decimal? @db.Decimal(10, 2)
  isListedInMarketplace    Boolean  @default(false)
  marketplaceRatingAverage Decimal  @default(0) @db.Decimal(2, 1)
  marketplaceRatingCount   Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("accounting_firm_profiles")
}

model AccountingEngagement {
  id                     String                      @id @default(uuid())
  accountingFirmTenantId String
  clientTenantId         String
  scopes                 AccountingEngagementScope[]
  status                 AccountingEngagementStatus  @default(PENDING_ACCOUNTANT_ACCEPTANCE)
  grantedByUserId        String
  grantedAt              DateTime                    @default(now())
  acceptanceDeadlineAt   DateTime
  acceptedByUserId       String?
  acceptedAt             DateTime?
  revokedByUserId        String?
  revokedAt              DateTime?
  revokedReason          String?

  firmTenant   Tenant                            @relation("EngagementsAsFirm", fields: [accountingFirmTenantId], references: [id], onDelete: Cascade)
  clientTenant Tenant                            @relation("EngagementsAsClient", fields: [clientTenantId], references: [id], onDelete: Cascade)
  auditEvents  AccountingEngagementAuditEvent[]
  fees         AccountingEngagementFee[]
  tasks        AccountingTask[]
  reviews      AccountingMarketplaceReview[]

  @@index([accountingFirmTenantId, status])
  @@index([clientTenantId, status])
  @@map("accounting_engagements")
}

model AccountingEngagementAuditEvent {
  id           String                          @id @default(uuid())
  engagementId String
  eventType    AccountingEngagementEventType
  actorUserId  String?
  occurredAt   DateTime                        @default(now())
  metadata     Json?

  engagement   AccountingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId, occurredAt])
  @@map("accounting_engagement_audit_events")
}

model AccountingEngagementFee {
  id                  String    @id @default(uuid())
  engagementId        String
  amount              Decimal   @db.Decimal(10, 2)
  periodicity         String    // "MONTHLY" | "ONE_TIME"
  dueDay              Int?
  accountReceivableId String?
  accountPayableId    String?
  createdAt           DateTime  @default(now())

  engagement          AccountingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("accounting_engagement_fees")
}

model AccountingTask {
  id                     String               @id @default(uuid())
  accountingFirmTenantId String
  clientTenantId         String
  engagementId           String?
  taskType               AccountingTaskType
  competencia            String
  dueDate                DateTime
  status                 AccountingTaskStatus @default(PENDING)
  assignedUserId         String?
  completedAt            DateTime?
  resultingDocumentId    String?

  firmTenant   Tenant                @relation("AccountingTasksAsFirm", fields: [accountingFirmTenantId], references: [id], onDelete: Cascade)
  clientTenant Tenant                @relation("AccountingTasksAsClient", fields: [clientTenantId], references: [id], onDelete: Cascade)
  engagement   AccountingEngagement? @relation(fields: [engagementId], references: [id])

  @@index([accountingFirmTenantId, status, dueDate])
  @@index([clientTenantId, competencia])
  @@map("accounting_tasks")
}

model OfficialTaxDocument {
  id                              String                    @id @default(uuid())
  tenantId                        String
  generatedByAccountingFirmTenantId String?
  documentType                    OfficialTaxDocumentType
  layoutVersion                   String
  competenciaInicio               DateTime
  competenciaFim                  DateTime
  fileUrl                         String
  transmissionProtocol            String?
  rejectionReason                 String?
  status                          OfficialTaxDocumentStatus @default(DRAFT)
  generatedAt                     DateTime                  @default(now())

  tenant           Tenant  @relation("OfficialTaxDocumentsOfTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  generatedByFirm  Tenant? @relation("OfficialTaxDocumentsGeneratedByFirm", fields: [generatedByAccountingFirmTenantId], references: [id])

  @@index([tenantId, documentType, competenciaInicio])
  @@map("official_tax_documents")
}

model AccountingMarketplaceReview {
  id                     String   @id @default(uuid())
  accountingFirmTenantId String
  clientTenantId         String
  engagementId           String
  authorUserId           String
  rating                 Int
  comment                String?  @db.Text
  createdAt              DateTime @default(now())

  engagement AccountingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, authorUserId])
  @@index([accountingFirmTenantId])
  @@map("accounting_marketplace_reviews")
}

// ─────────────────────────────────────────────────────────────────────────
// FILITECH PESSOAL (B2C) — CONTAS, INVESTIMENTOS, OPEN FINANCE — Cap. 22
// ─────────────────────────────────────────────────────────────────────────

enum PersonalAccountType {
  CHECKING
  SAVINGS
  WALLET_CASH
  CREDIT_CARD
  INVESTMENT_BROKERAGE
}

model PersonalAccount {
  id                 String              @id @default(uuid())
  tenantId           String
  ownerId            String?             // User que cadastrou; null = conta explicitamente do casal (sem dono único)
  name               String
  type               PersonalAccountType
  institutionName    String?             // "Nubank", "Itaú", "Carteira" etc.
  currentBalance     Decimal             @default(0) @db.Decimal(14, 2)
  creditLimit        Decimal?            @db.Decimal(14, 2) // obrigatório em uso quando type = CREDIT_CARD
  invoiceClosingDay  Int?                // dia do mês em que a fatura fecha (type = CREDIT_CARD)
  invoiceDueDay      Int?                // dia do mês de vencimento da fatura (type = CREDIT_CARD)
  isShared           Boolean             @default(true) // visível para todos os membros da residência (Cap. 22.3)
  openFinanceConsentId String?           // preenchido quando a conta é sincronizada automaticamente (Cap. 22.5)
  openFinanceExternalAccountId String?  // id lógico da conta no agregador — evita duplicar a mesma conta a cada novo "item/updated" da Pluggy
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant             Tenant              @relation("PersonalAccountTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  owner              User?               @relation("PersonalAccountOwner", fields: [ownerId], references: [id])
  openFinanceConsent OpenFinanceConsent? @relation(fields: [openFinanceConsentId], references: [id])
  transactions       PersonalTransaction[]
  investments        PersonalInvestment[]
  goals              PersonalGoal[]
  billsAutoDebit     PersonalBill[]

  @@index([tenantId, type])
  // Identidade lógica da conta externa sincronizada via Open Finance (Cap. 22.5)
  // — evita criar uma PersonalAccount duplicada a cada novo "item/updated" da Pluggy
  // para a mesma instituição dentro do mesmo consentimento.
  @@unique([openFinanceConsentId, institutionName])
  @@map("personal_accounts")
}

model BankAccount {
  id                     String   @id @default(uuid())
  tenantId               String
  bankName               String
  agencyNumber           String
  accountNumber          String
  currentBalance         Decimal  @default(0) @db.Decimal(12, 2)
  openFinanceConsentId   String?  // preenchido quando a conta é sincronizada automaticamente, mesmo padrão de PersonalAccount
  openFinanceExternalAccountId String? // id lógico da conta no agregador — evita duplicar a mesma conta a cada reconexão

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openFinanceConsent OpenFinanceConsent? @relation(fields: [openFinanceConsentId], references: [id])
  transactions   BankTransaction[]

  @@unique([openFinanceConsentId, openFinanceExternalAccountId])
  @@map("bank_accounts")
}

enum BankTransactionReconciliationStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  IGNORED
}

model BankTransaction {
  id                String                               @id @default(uuid())
  tenantId          String
  bankAccountId     String
  externalFitId     String  // FITID do OFX (importação manual) OU id da transação no agregador Open Finance (sincronização automática, Cap. 17.4.1) — em ambos os casos, a chave de idempotência real do banco/agregador, nunca um id interno
  description       String
  amount            Decimal                               @db.Decimal(12, 2)
  transactionDate   DateTime
  reconciliationStatus BankTransactionReconciliationStatus @default(UNMATCHED)
  matchedAccountPayableId    String?
  matchedAccountReceivableId String?
  importedAt        DateTime                               @default(now())

  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bankAccountId, externalFitId])
  @@map("bank_transactions")
}

// ─────────────────────────────────────────────────────────────────────────
// FILITECH PESSOAL (B2C) — TRANSAÇÕES, CATEGORIAS, ORÇAMENTOS — Cap. 22
// ─────────────────────────────────────────────────────────────────────────

enum PersonalTransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model PersonalTransaction {
  id                     String                  @id @default(uuid())
  tenantId               String
  accountId              String
  categoryId             String?
  createdByUserId        String
  recurrenceRuleId       String?
  description            String
  merchantName           String?                 // nome do estabelecimento (extraído do extrato ou do Open Finance), usado no motor de categorização automática (Cap. 22.4)
  type                   PersonalTransactionType
  amount                 Decimal                 @db.Decimal(14, 2) // sempre positivo; o "type" define o sinal no cálculo de saldo, nunca um valor negativo armazenado
  transactionDate        DateTime
  isPrivate              Boolean                 @default(false) // Cap. 22.3 — visível apenas para createdByUserId dentro da residência
  isRecurring            Boolean                 @default(false) // Gerado a partir de regra de recorrência (Cap. 22.6)
  attachmentStorageKey   String?                 // foto do recibo, R2 (Cap. 20.5)
  openFinanceExternalId  String?                 @unique // idempotência: evita duplicar a mesma transação em cada sincronização do Open Finance (Cap. 22.5)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account                PersonalAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category               PersonalCategory?       @relation(fields: [categoryId], references: [id])
  createdBy              User                    @relation(fields: [createdByUserId], references: [id])
  recurrenceRule         PersonalRecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])
  splits                 PersonalTransactionSplit[]
  @@index([tenantId, accountId, transactionDate])
  @@index([tenantId, categoryId, transactionDate])
  @@map("personal_transactions")
}

model PersonalTransactionSplit {
  id            String              @id @default(uuid())
  transactionId String
  userId        String
  percentage    Decimal             @db.Decimal(5, 2)
  amount        Decimal             @db.Decimal(14, 2)

  transaction   PersonalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id])

  @@unique([transactionId, userId])
  @@map("personal_transaction_splits")
}

enum PersonalRecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model PersonalRecurrenceRule {
  id                   String                      @id @default(uuid())
  tenantId             String
  frequency            PersonalRecurrenceFrequency
  dayOfMonth           Int?                        // obrigatório quando frequency = MONTHLY/YEARLY
  interval             Int                       // intervalos: WEEKLY=1, MONTHLY=1, YEARLY=1; custom values for skip-patterns
  templateDescription  String
  templateAmount       Decimal                     @db.Decimal(14, 2)
  templateAccountId    String
  templateCategoryId   String?
  templateType         PersonalTransactionType     @default(EXPENSE)
  nextOccurrenceAt     DateTime
  endDate              DateTime?
  active               Boolean                     @default(true)
  createdAt            DateTime                    @default(now())

  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generatedTransactions PersonalTransaction[]
  @@index([tenantId, active, nextOccurrenceAt])
  @@map("personal_recurrence_rules")
}

enum PersonalCategoryType {
  INCOME
  EXPENSE
}

model PersonalCategory {
  id               String               @id @default(uuid())
  tenantId         String
  parentCategoryId String?
  name             String
  icon             String?              // nome do ícone MUI (Cap. 8) — ex.: "LocalGroceryStore"
  type             PersonalCategoryType
  isSystemDefault  Boolean              @default(false) // categorias seedadas no onboarding (Moradia, Alimentação, Transporte, Lazer, Saúde, Educação, Investimentos) — não podem ser excluídas, apenas desativadas
  isCarneLeaoIncome Boolean             @default(false) // marca rendimento tributável sujeito a Carnê-Leão (aluguel/autônomo recebido de PF) — Cap. 22.11
  active           Boolean              @default(true)

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentCategory   PersonalCategory?    @relation("PersonalCategoryHierarchy", fields: [parentCategoryId], references: [id])
  subcategories    PersonalCategory[]   @relation("PersonalCategoryHierarchy")
  transactions     PersonalTransaction[]
  budgets          PersonalBudget[]
  bills            PersonalBill[]

  @@index([tenantId, type])
  @@map("personal_categories")
}

model PersonalBudget {
  id             String           @id @default(uuid())
  tenantId       String
  categoryId     String
  monthReference DateTime         // sempre normalizado para o dia 01 do mês de referência
  limitAmount    Decimal          @db.Decimal(14, 2)
  rolloverEnabled Boolean         @default(false) // se true, saldo não gasto do mês anterior soma ao limite do mês seguinte
  alertThreshold  Int             @default(80) // porcentagem (80% = alerta de aviso, 100% = alerta de estouro)

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       PersonalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoryId, monthReference])
  @@map("personal_budgets")
}

enum PersonalGoalType {
  SAVINGS
  DEBT_PAYOFF
  EMERGENCY_FUND
  PURCHASE
}

enum PersonalGoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model PersonalGoal {
  id              String             @id @default(uuid())
  tenantId        String
  linkedAccountId String?            // conta-poupança dedicada à meta, se existir
  name            String
  type            PersonalGoalType
  targetAmount    Decimal            @db.Decimal(14, 2)
  currentAmount   Decimal            @default(0) @db.Decimal(14, 2)
  targetDate      DateTime?
  status          PersonalGoalStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedAccount   PersonalAccount?   @relation(fields: [linkedAccountId], references: [id])

  @@index([tenantId, status])
  @@map("personal_goals")
}

enum PersonalInvestmentAssetType {
  TESOURO_DIRETO
  CDB
  LCI_LCA
  ACOES
  FII
  CRIPTO
  PREVIDENCIA_PRIVADA
  POUPANCA
}

model PersonalInvestment {
  id                    String                      @id @default(uuid())
  tenantId              String
  accountId             String
  assetType             PersonalInvestmentAssetType
  assetName             String
  ticker                String?
  quantity              Decimal                     @db.Decimal(18, 8) // precisão alta — necessária para frações de cripto
  averagePrice          Decimal                     @db.Decimal(14, 2)
  currentPrice          Decimal                     @db.Decimal(14, 2)
  openFinanceExternalId String?                     @unique // idempotência de sincronização (Cap. 22.5)
  updatedAt             DateTime                    @updatedAt

  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account               PersonalAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  priceHistory          PersonalInvestmentPriceHistory[]
  @@index([tenantId, assetType])
  @@map("personal_investments")
}

model PersonalInvestmentPriceHistory {
  id           String             @id @default(uuid())
  investmentId String
  priceDate    DateTime
  closingPrice Decimal            @db.Decimal(14, 2)

  investment   PersonalInvestment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([investmentId, priceDate])
  @@map("personal_investment_price_history")
}

enum PersonalDebtType {
  FINANCIAMENTO_IMOVEL
  FINANCIAMENTO_VEICULO
  EMPRESTIMO_PESSOAL
  CARTAO_PARCELADO
  CHEQUE_ESPECIAL
}

enum PersonalDebtStatus {
  ACTIVE
  PAID_OFF
}

model PersonalDebt {
  id                  String             @id @default(uuid())
  tenantId            String
  name                String
  type                PersonalDebtType
  originalAmount      Decimal            @db.Decimal(14, 2)
  remainingAmount     Decimal            @db.Decimal(14, 2)
  interestRateMonthly Decimal            @db.Decimal(6, 4) // ex.: 1.99 = 1,99% a.m., usado no calculador de quitação (Cap. 22.6)
  installmentsTotal   Int
  installmentsPaid    Int                @default(0)
  dueDay              Int
  status              PersonalDebtStatus @default(ACTIVE)
  createdAt           DateTime           @default(now())

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installments        PersonalDebtInstallment[]
  @@index([tenantId, status])
  @@map("personal_debts")
}

enum PersonalDebtInstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

model PersonalDebtInstallment {
  id                String                        @id @default(uuid())
  debtId            String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal                       @db.Decimal(14, 2)
  paidAt            DateTime?
  status            PersonalDebtInstallmentStatus @default(PENDING)

  debt              PersonalDebt                  @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([debtId, installmentNumber])
  @@map("personal_debt_installments")
}

enum PersonalBillStatus {
  PENDING
  PAID
  OVERDUE
}

model PersonalBill {
  id                  String             @id @default(uuid())
  tenantId            String
  categoryId          String?
  autoDebitAccountId  String?
  name                String
  amount              Decimal            @db.Decimal(14, 2) // estimado para contas de valor variável (luz/água); ajustado manualmente a cada lançamento real
  dueDay              Int
  isRecurring         Boolean            @default(true)
  reminderDaysBefore  Int                @default(3)
  lastPaidAt          DateTime?
  status              PersonalBillStatus @default(PENDING)
  createdAt           DateTime           @default(now())

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category            PersonalCategory?  @relation(fields: [categoryId], references: [id])
  autoDebitAccount    PersonalAccount?   @relation(fields: [autoDebitAccountId], references: [id])

  @@index([tenantId, status, dueDay])
  @@map("personal_bills")
}

model NetWorthSnapshot {
  id                String   @id @default(uuid())
  tenantId          String
  snapshotDate      DateTime
  totalAssets       Decimal  @db.Decimal(16, 2) // soma de PersonalAccount.currentBalance (exceto CREDIT_CARD) + PersonalInvestment (quantity * currentPrice)
  totalLiabilities  Decimal  @db.Decimal(16, 2) // soma de PersonalDebt.remainingAmount + faturas de cartão em aberto
  netWorth          Decimal  @db.Decimal(16, 2) // totalAssets - totalLiabilities, nunca recebido do cliente — sempre recalculado no servidor

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate])
  @@map("net_worth_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM ADMIN — Cap. 13
// ─────────────────────────────────────────────────────────────────────────

enum PlatformAdminRole {
  SUPER_ADMIN
  FINANCE_ANALYST
  SUPPORT_AGENT
  DEVOPS
}

model PlatformAdminUser {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  passwordHash      String
  role              PlatformAdminRole  @default(SUPPORT_AGENT)
  active            Boolean            @default(true)
  totpSecretEncrypted String?
  totpConfirmedAt   DateTime?
  backupCodes       TwoFactorBackupCode[]
  activeSessions    PlatformAdminSession[]
  auditLogs         PlatformAdminAuditLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("platform_admin_users")
}

model PlatformAdminSession {
  id            String   @id @default(uuid())
  userId        String
  sessionId     String   @unique
  ipAddress     String?
  userAgent     String?
  lastActivity  DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user          PlatformAdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("platform_admin_sessions")
}

model PlatformAdminAuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        PlatformAdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("platform_admin_audit_logs")
}

model AdminIpAllowlistEntry {
  id          String   @id @default(uuid())
  cidr        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_ip_allowlist")
}

// ─────────────────────────────────────────────────────────────────────────
// BILLING EXTRAS — Cap. 2.7 / 2.8
// ─────────────────────────────────────────────────────────────────────────

model DiscountCoupon {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String?
  discountPercent Decimal  @db.Decimal(5, 2)
  maxUses         Int?
  usedCount       Int      @default(0)
  validFrom       DateTime
  validUntil      DateTime
  applicablePlans String[] // códigos dos planos; vazio = todos
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("discount_coupons")
}

model ReleaseNote {
  id          String   @id @default(uuid())
  version     String
  title       String
  body        String   @db.Text
  isPublic    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@map("release_notes")
}

model IncidentEvent {
  id          String   @id @default(uuid())
  component   String   // "API" | "WEBHOOKS" | "DATABASE" | "PDV" | "BILLING" | "EMAIL" | "WHATSAPP" | "FISCAL"
  severity    String   // "OUTAGE" | "DEGRADED" | "MAINTENANCE"
  title       String
  description String   @db.Text
  startedAt   DateTime
  resolvedAt  DateTime?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([component, startedAt])
  @@map("incident_events")
}

// ─────────────────────────────────────────────────────────────────────────
// HELPDESK INTERNO — Cap. 15.3
// ─────────────────────────────────────────────────────────────────────────

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_THIRD_PARTY
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketCategory {
  BILLING
  TECHNICAL
  FISCAL
  ACCOUNT
  FEATURE_REQUEST
  OTHER
}

model SupportTicket {
  id              String                 @id @default(uuid())
  tenantId        String
  userId          String
  category        SupportTicketCategory
  priority        SupportTicketPriority  @default(NORMAL)
  status          SupportTicketStatus    @default(OPEN)
  subject         String
  slaDeadlineAt   DateTime?
  assignedAgentId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        SupportTicketMessage[]

  @@index([tenantId, status, priority])
  @@index([assignedAgentId, status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  authorId    String
  authorType  String   // "TENANT_USER" | "SUPPORT_AGENT" | "SYSTEM"
  body        String   @db.Text
  attachments String[] // R2 keys
  createdAt   DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANT API KEYS & WEBHOOKS — Cap. 15.4
// ─────────────────────────────────────────────────────────────────────────

enum TenantApiKeyScope {
  READ_PRODUCTS
  WRITE_PRODUCTS
  READ_SALES
  WRITE_SALES
  READ_CLIENTS
  WRITE_CLIENTS
  READ_FINANCIAL
  WRITE_FINANCIAL
  READ_FISCAL
  WRITE_FISCAL
  READ_INVENTORY
  WRITE_INVENTORY
  WEBHOOKS_MANAGE
  ADMIN_FULL
}

model TenantApiKey {
  id          String              @id @default(uuid())
  tenantId    String
  name        String
  keyPrefix   String              // ex.: "fltk_live_"
  keyHash     String              // SHA-256 da chave completa
  scopes      TenantApiKeyScope[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, revokedAt])
  @@map("tenant_api_keys")
}

model TenantWebhookEndpoint {
  id                    String   @id @default(uuid())
  tenantId              String
  url                   String
  events                String[] // ex.: ["sale.completed", "payment.failed", "nfe.authorized"]
  signingSecretEncrypted String
  active                Boolean  @default(true)
  lastDeliveryAt        DateTime?
  lastDeliverySuccess   Boolean?
  lastDeliveryStatus    Int?
  failureCount          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries            WebhookDelivery[]

  @@index([tenantId, active])
  @@map("tenant_webhook_endpoints")
}

model WebhookDelivery {
  id              String   @id @default(uuid())
  endpointId      String
  eventType       String
  payload         Json
  responseStatus  Int?
  responseBody    String?
  attempt         Int      @default(1)
  deliveredAt     DateTime?
  nextRetryAt     DateTime?
  createdAt       DateTime @default(now())

  endpoint        TenantWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

enum PartnerRole {
  SOCIO_ADMINISTRADOR
  SOCIO_QUOTISTA
  INVESTIDOR
}

model CompanyPartner {
  id              String      @id @default(uuid())
  tenantId        String
  name            String
  document        String
  email           String?
  phone           String?
  role            PartnerRole
  equityPercent   Decimal     @db.Decimal(5, 2)
  proLabore       Decimal?    @db.Decimal(12, 2)
  profitShare     Decimal?    @db.Decimal(5, 2)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payouts         PartnerPayout[]

  @@unique([tenantId, document])
  @@map("company_partners")
}

model PartnerPayout {
  id              String   @id @default(uuid())
  tenantId        String
  partnerId       String
  amount          Decimal  @db.Decimal(12, 2)
  type            String   // "PRO_LABORE" | "PROFIT_DISTRIBUTION" | "REIMBURSEMENT"
  description     String?
  paidAt          DateTime
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner         CompanyPartner @relation(fields: [partnerId], references: [id])

  @@index([tenantId, partnerId, createdAt])
  @@map("partner_payouts")
}

// ─────────────────────────────────────────────────────────────────────────
// BACKUP RECORDS — Cap. 10.3
// ─────────────────────────────────────────────────────────────────────────

model BackupRecord {
  id              String   @id @default(uuid())
  tenantId        String
  fileName        String
  r2Key           String
  sizeBytes       Int
  encryptionAlgo  String
  status          String   @default("PENDING") // PENDING | COMPLETED | FAILED
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("backup_records")
}

// ─────────────────────────────────────────────────────────────────────────
// LEGAL DOCUMENT VERSIONS (LGPD) — Cap. 1.2.1
// ─────────────────────────────────────────────────────────────────────────

enum LegalDocumentType {
  TERMS_OF_USE
  PRIVACY_POLICY
}

model LegalDocumentVersion {
  id          String             @id @default(uuid())
  type        LegalDocumentType
  version     String
  content     String             @db.Text
  effectiveAt DateTime
  createdAt   DateTime           @default(now())

  @@unique([type, version])
  @@index([type, effectiveAt])
  @@map("legal_document_versions")
}

// ─────────────────────────────────────────────────────────────────────────
// ROLE DEFAULT PERMISSIONS — Cap. 14
// ─────────────────────────────────────────────────────────────────────────

model RoleDefaultPermission {
  id          String   @id @default(uuid())
  role        String
  permission  String

  @@unique([role, permission])
  @@map("role_default_permissions")
}
