// prisma/schema.prisma — BIBLE_ENGINEERING_V2 (Capítulos 5 + 12)
// Fonte de verdade: BIBLE_ENGINEERING_V2.md

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANCY, PLANOS E MOTOR DE MÓDULOS (BILLING À LA CARTE) — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// NICHOS (Cap. 11 / 1.2.2) — motor de seleção e personalização
// ─────────────────────────────────────────────────────────────────────────────

/// Nicho de negócio do tenant. Determina o template de catálogo, os módulos
/// sugeridos e as funcionalidades exibidas na vitrine e no onboarding.
enum NicheCode {
  MERCADO
  ASSISTENCIA_TECNICA
  ADEGA
  PADARIA
  FARMACIA
  VAREJO_GERAL
  RESTAURANTE
  PETSHOP
  SALAO_BELARIA
  AUTOMOTIVA
  OTICA
  MODA_CALCADOS
  PAPELARIA
  CONSTRUCAO
  ESCRITORIO_CONTABILIDADE
  PERSONAL
}

/// Regime tributário real do tenant (Cap. 21.1) — determina a fórmula de
/// cálculo de imposto aplicada em toda venda, nunca alíquota fixa no código.
enum TaxRegime {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

model Niche {
  code        NicheCode @id
  label       String
  tagline     String
  description String    @db.Text
  /// Módulos sugeridos por padrão para este nicho (Cap. 1.2.2 — pré-carrega
  /// o template em vez de mostrar tela em branco).
  suggestedModules String[]
  /// Nichos que o usuário pode escolher durante o cadastro.
  selectableOnSignup Boolean @default(true)
  icon       String?
  colorHex   String?
  sortOrder  Int        @default(0)
  active     Boolean    @default(true)

  tenants        Tenant[]
  features       NicheFeature[]
  templateItems  NicheTemplateProduct[]

  @@index([active, sortOrder])
  @@map("niches")
}

/// Funcionalidade exibida na vitrine ao selecionar um nicho.
model NicheFeature {
  id        String    @id @default(uuid())
  nicheCode NicheCode
  title     String
  description String  @db.Text
  /// Referência ao capítulo da BÍBLIA que especifica a feature.
  chapterRef String?
  icon      String?
  sortOrder Int       @default(0)

  niche Niche @relation(fields: [nicheCode], references: [code], onDelete: Cascade)

  @@index([nicheCode, sortOrder])
  @@map("niche_features")
}

/// Produto-exemplo do template que o tenant recebe ao escolher o nicho.
model NicheTemplateProduct {
  id        String    @id @default(uuid())
  nicheCode NicheCode
  name      String
  category  String?
  unitPrice Decimal   @db.Decimal(12, 2)
  skuPrefix String?
  sortOrder Int       @default(0)

  niche Niche @relation(fields: [nicheCode], references: [code], onDelete: Cascade)

  @@index([nicheCode, sortOrder])
  @@map("niche_template_products")
}

// Natureza do tenant (Cap. 21.18.1 / 21.17).
// ACCOUNTING_OFFICE marca o escritório de contabilidade que TAMBÉM é tenant
// da plataforma — é ele que possui `accountingFirmProfile` e aparece no
// marketplace (21.18.6). BUSINESS é o lojista normal; PERSONAL, o CPF.
enum TenantType {
  BUSINESS
  PERSONAL
  ACCOUNTING_OFFICE
}

model Tenant {
  id                String       @id @default(uuid())
  parentTenantId    String?
  slug              String       @unique
  legalName         String
  tradeName         String
  cnpj              String       @unique
  status            TenantStatus @default(TRIAL)
  gracePeriodEndsAt DateTime?
  // Nicho escolhido no onboarding (Cap. 1.2.2) — determina o template de
  // catálogo pré-carregado e as funcionalidades exibidas na vitrine.
  nicheCode         NicheCode?
  // Regime tributário real (Cap. 21.1) — nunca alíquota fixa hardcoded no código.
  taxRegime         TaxRegime    @default(SIMPLES_NACIONAL)
  simplesNacionalAnexo String?
  inscricaoEstadual String?
  uf                String?
  // Tipo do tenant (Cap. 21.18) — um escritório de contabilidade é um tenant
  // BUSINESS normal, só que com `tenantType = ACCOUNTING_OFFICE` e um
  // `accountingFirmProfile` para ser listado no marketplace de contadores.
  tenantType        TenantType   @default(BUSINESS)
  // Faturamento do tenant no mês corrente (consolidado pelo PDV). Base de
  // cálculo dos limites do Tier Free (Cap. 2.4) e do regime de cobrança.
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parentTenant      Tenant?       @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  childTenants       Tenant[]      @relation("TenantHierarchy")
  subscriptions     Subscription[]
  tenantModules     TenantModule[]
  users             User[]
  clients           Client[]
  suppliers         Supplier[]
  products          Product[]
  productBatches    ProductBatch[]
  productSerials    ProductSerial[]
  productVariants   ProductVariant[]
  recipes           Recipe[]
  productionBatches ProductionBatch[]
  workOrders        WorkOrder[]
  sales             Sale[]
  cashRegisters     CashRegister[]
  stockMovements    StockMovement[]
  fiscalDocuments   FiscalDocument[]
  accountsPayable   AccountPayable[]
  accountsReceivable AccountReceivable[]
  paymentCharges    PaymentCharge[]
  returnableLedgerEntries ReturnableContainerLedger[]
  services          Service[]
  appointments      Appointment[]
  clientPackages    ClientServicePackage[]
  comandas          Comanda[]
  restaurantTables  RestaurantTable[]
  opticalPrescriptions OpticalPrescription[]
  pets              Pet[]
  vaccineRecords    VaccineRecord[]
  vehicles          Vehicle[]
  vehicleListings   VehicleListing[]
  serviceContracts  ServiceContract[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  loyaltyProgram    LoyaltyProgram?
  loyaltyAccounts   LoyaltyAccount[]
  referralCode      ReferralCode?
  referredAs        Referral?         @relation("ReferredTenant")
  passwordResetTokens PasswordResetToken[]
  niche             Niche?            @relation(fields: [nicheCode], references: [code])

  onlineStoreSettings        OnlineStoreSettings?
  openFinanceConsents        OpenFinanceConsent[]
  fiscalDocumentEvents       FiscalDocumentEvent[]
  chartOfAccounts            ChartOfAccount[]
  costCenters                CostCenter[]
  purchaseOrders             PurchaseOrder[]
  inventoryCounts            InventoryCount[]
  reportDefinitions          ReportDefinition[]
  scheduledReports           ScheduledReport[]
  dashboardLayouts           DashboardLayout[]
  dataImportJobs             DataImportJob[]
  taxRules                   TaxRule[]
  ibsCbsRegimeElections      TenantIbsCbsRegimeElection[]
  accountingFirmProfile      AccountingFirmProfile?
  engagementsAsFirm          AccountingEngagement[] @relation("EngagementsAsFirm")
  engagementsAsClient        AccountingEngagement[] @relation("EngagementsAsClient")
  accountingTasksAsFirm      AccountingTask[] @relation("AccountingTasksAsFirm")
  accountingTasksAsClient    AccountingTask[] @relation("AccountingTasksAsClient")
  officialTaxDocuments       OfficialTaxDocument[] @relation("OfficialTaxDocumentsOfTenant")
  officialTaxDocumentsGenerated OfficialTaxDocument[] @relation("OfficialTaxDocumentsGeneratedByFirm")
  netWorthSnapshots    NetWorthSnapshot[]
  personalBills        PersonalBill[]
  personalDebts        PersonalDebt[]
  personalInvestments  PersonalInvestment[]
  personalGoals        PersonalGoal[]
  personalBudgets      PersonalBudget[]
  personalCategories   PersonalCategory[]
  personalRecurrenceRules PersonalRecurrenceRule[]
  personalTransactions PersonalTransaction[]
  bankAccounts         BankAccount[]
  personalAccounts     PersonalAccount[] @relation("PersonalAccountTenant")
  supportTickets        SupportTicket[]
  apiKeys               TenantApiKey[]
  webhookEndpoints      TenantWebhookEndpoint[]
  companyPartners       CompanyPartner[]
  partnerPayouts        PartnerPayout[]
  backupRecords         BackupRecord[]
  @@index([status])
  @@index([parentTenantId])
  @@map("tenants")
}

model Plan {
  id              String   @id @default(uuid())
  code            String   @unique
  label           String
  basePrice       Decimal  @db.Decimal(10, 2)
  includedModules String[]
  active          Boolean  @default(true)

  subscriptions   Subscription[]

  @@map("plans")
}

model Module {
  id           String   @id @default(uuid())
  code         String   @unique
  label        String
  monthlyPrice Decimal  @db.Decimal(10, 2)
  description  String
  active       Boolean  @default(true)

  tenantModules TenantModule[]

  @@map("modules")
}

model TenantModule {
  id         String   @id @default(uuid())
  tenantId   String
  moduleCode String
  active     Boolean  @default(true)
  activatedAt DateTime @default(now())
  deactivatedAt DateTime?

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleCode], references: [code])

  @@unique([tenantId, moduleCode])
  @@index([tenantId, active])
  @@map("tenant_modules")
}

// System parameters for global configuration (2FA enforcement, etc.)
model SystemParameter {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("system_parameter")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id                      String             @id @default(uuid())
  tenantId                String
  planId                  String
  provider                String
  externalSubscriptionId  String             @unique
  status                  SubscriptionStatus @default(TRIAL)
  pastDueSince            DateTime?
  currentPeriodEnd        DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  // Cobrança recorrente real (Cap. 2.7)
  paymentMethodToken      String?
  paymentMethodBrand      String?
  paymentMethodLast4      String?
  failedPaymentAttempts   Int                @default(0)
  nextRetryAt             DateTime?
  // Cancelamento e reembolso (Cap. 2.7.6)
  firstChargedAt          DateTime?
  cancelRequestedAt       DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  // Programa de Indicação (Cap. 2.8)
  creditBalanceMonths     Int                @default(0)
  firstCycleDiscountPercent Int?

  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                    Plan               @relation(fields: [planId], references: [id])
  billingEvents           BillingEvent[]
  paymentCharges          PaymentCharge[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

model BillingEvent {
  id               String       @id @default(uuid())
  subscriptionId   String?
  /// Cobrança avulsa associada (cap. 17.5 / módulo sem assinatura).
  paymentChargeId  String?
  provider         String
  externalEventKey String
  type             String
  payload          Json
  createdAt        DateTime     @default(now())

  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paymentCharge    PaymentCharge? @relation(fields: [paymentChargeId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventKey])
  @@index([subscriptionId, createdAt])
  @@index([paymentChargeId, createdAt])
  @@map("billing_events")
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY & RBAC — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  TECHNICIAN
  CASHIER
  // Papel somente-leitura financeiro do Portal do Contador (Cap. 20.9/21.18) —
  // sem acesso a PDV/estoque/CRM; serve para o escritorio dar entrada nos
  // documentos fiscais do cliente que o contratou.
  ACCOUNTANT
}

model User {
  id                    String    @id @default(uuid())
  tenantId              String
  name                  String
  email                 String
  passwordHash          String
  role                  UserRole
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // 2FA / Auth extras (Cap. 14)
  totpSecretEncrypted   String?
  totpConfirmedAt       DateTime?
  managerPinHash        String?
  preferredThemeMode    String    @default("light")
  // CRM / Comunicação
  phone                 String?

  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions       RolePermission[]
  sales                 Sale[]
  workOrders            WorkOrder[]  @relation("AssignedTechnician")
  cashRegisters         CashRegister[]
  osPhotos              OsPhoto[]
  appointments          Appointment[] @relation("AppointmentProfessional")
  backupCodes           TwoFactorBackupCode[]
  passwordResetTokens   PasswordResetToken[]
  activeSessions        ActiveSession[]
  auditLogs             AuditLog[]
  notifications         Notification[] @relation("UserNotifications")

  cashRegisterMovements      CashRegisterMovement[]
  purchaseOrdersCreated      PurchaseOrder[]
  inventoryCountsStarted     InventoryCount[] @relation("InventoryCountStartedBy")
  inventoryCountsApproved    InventoryCount[] @relation("InventoryCountApprovedBy")
  inventoryCountItems        InventoryCountItem[]
  reportDefinitionsCreated   ReportDefinition[]
  dashboardLayout            DashboardLayout?
  dataImportJobsCreated      DataImportJob[]
  ibsCbsRegimeElections      TenantIbsCbsRegimeElection[]
  personalTransactionSplits PersonalTransactionSplit[]
  personalTransactionsCreated PersonalTransaction[]
  personalAccountsOwned     PersonalAccount[] @relation("PersonalAccountOwner")
  supportTickets          SupportTicket[]
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

model RolePermission {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  permission String
  granted    Boolean  @default(true)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([tenantId, userId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
// PARTIES — CLIENTS & SUPPLIERS — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  document     String?
  phone        String?
  email        String?
  creditLimit  Decimal  @default(0) @db.Decimal(12, 2)
  creditBalanceUsed Decimal @default(0) @db.Decimal(12, 2)
  isBusinessAccount Boolean @default(false) // Cap. 11.8 — perfil construtora/empreiteiro
  whatsappOptInAt  DateTime? // Capítulo 20.2.1 — opt-in explícito para mensagens MARKETING
  whatsappOptOutAt DateTime? // Capítulo 20.2.1 — bloqueia qualquer novo envio até novo opt-in
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales        Sale[]
  workOrders   WorkOrder[]
  containerLedgerEntries ReturnableContainerLedger[]
  accountsReceivable AccountReceivable[]
  pets         Pet[]
  vehicles     Vehicle[]
  opticalPrescriptions OpticalPrescription[]
  clientPackages ClientServicePackage[]
  comandas     Comanda[]
  appointments Appointment[]
  consignedListings VehicleListing[]
  serviceContracts ServiceContract[]

  @@unique([tenantId, document])
  @@index([tenantId, name])
  @@map("clients")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  accountsPayable AccountPayable[]

  purchaseOrders             PurchaseOrder[]
  @@unique([tenantId, document])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────
// PRODUCT CATALOG — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum ProductTrackingType {
  NONE
  BATCH
  SERIAL
  VARIANT
}

enum ProductSaleUnit {
  UNIT
  KG
  METER
  SQUARE_METER
  CUBIC_METER
  LITER
}

model Product {
  id                    String              @id @default(uuid())
  tenantId              String
  supplierId            String?
  sku                   String
  barcode               String?
  name                  String
  description           String?
  category              String?
  trackingType          ProductTrackingType @default(NONE)
  unitPrice             Decimal             @db.Decimal(12, 2)
  wholesalePrice        Decimal?            @db.Decimal(12, 2)
  resalePrice           Decimal?            @db.Decimal(12, 2)
  wholesaleMinQty       Int?
  stockQuantity         Decimal             @default(0) @db.Decimal(12, 3)
  minStockThreshold     Decimal?            @db.Decimal(12, 3)
  isWeighted            Boolean             @default(false)
  isReturnableContainer Boolean             @default(false)
  isReturnable          Boolean             @default(true)
  requiresPrescriptionRetention Boolean     @default(false)
  isControlledSubstance Boolean             @default(false)
  // Cap. 12 — venda fracionada (Material de Construção, Petshop granel, kits Papelaria)
  saleUnit              ProductSaleUnit     @default(UNIT)
  purchaseUnit          String?
  unitConversionFactor  Decimal?            @db.Decimal(12, 4)
  isKitComposition      Boolean             @default(false)
  active                Boolean             @default(true)
  reorderTargetQuantity Decimal?            @db.Decimal(12, 3) // quantidade alvo para reposição
  unit                  String              // unidade de medida (ex.: 'un', 'cx', 'kg', 'l') @default("un")
  averageCost           Decimal             @db.Decimal(12, 2) // custo médio por unidade (used in reorder suggestions)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier              Supplier?           @relation(fields: [supplierId], references: [id])
  batches               ProductBatch[]
  serials               ProductSerial[]
  variantAxes           ProductVariantAxis[]
  variants              ProductVariant[]
  recipe                Recipe?
  recipeUsages          RecipeItem[]        @relation("RecipeIngredient")
  saleItems             SaleItem[]
  workOrderItems        WorkOrderItem[]
  stockMovements        StockMovement[]
  productionBatchOutputs ProductionBatch[]  @relation("ProductionOutput")
  comandaItems          ComandaItem[]

  purchaseOrderItems         PurchaseOrderItem[]
  inventoryCountItems        InventoryCountItem[]
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, category])
  @@index([tenantId, active])
  @@map("products")
}

model ProductBatch {
  id                String   @id @default(uuid())
  tenantId          String
  productId         String
  batchNumber       String
  manufacturingDate DateTime?
  expirationDate    DateTime
  quantity          Decimal  @db.Decimal(12, 3)
  receivedAt        DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]

  inventoryCountItems        InventoryCountItem[]
  @@unique([tenantId, productId, batchNumber])
  @@index([tenantId, productId, expirationDate])
  @@map("product_batches")
}

model ProductSerial {
  id           String     @id @default(uuid())
  tenantId     String
  productId    String
  serialNumber String
  imei         String?
  status       String     @default("IN_STOCK")
  workOrderId  String?
  createdAt    DateTime   @default(now())

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@unique([tenantId, serialNumber])
  @@index([tenantId, imei])
  @@map("product_serials")
}

model ProductVariantAxis {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  name      String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@unique([tenantId, productId, name])
  @@map("product_variant_axes")
}

model ProductVariant {
  id            String             @id @default(uuid())
  tenantId      String
  productId     String
  axisId        String
  axisValue     String
  barcode       String?
  stockQuantity Decimal            @default(0) @db.Decimal(12, 3)
  priceOverride Decimal?           @db.Decimal(12, 2)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  axis          ProductVariantAxis @relation(fields: [axisId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]

  @@unique([tenantId, productId, axisValue])
  @@unique([tenantId, barcode])
  @@map("product_variants")
}

model PrescriptionRecord {
  id                 String   @id @default(uuid())
  tenantId           String
  saleItemId         String   @unique
  prescriptionType   String
  electronicPrescriptionNumber String?
  retainedDocumentStorageKey String?
  patientDocument    String
  validatedByUserId  String
  createdAt          DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("prescription_records")
}

// ─────────────────────────────────────────────────────────────────────────
// FICHA TÉCNICA / BOM E PRODUÇÃO — PADARIA — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

model Recipe {
  id            String       @id @default(uuid())
  tenantId      String
  productId     String       @unique
  yieldQuantity Decimal      @db.Decimal(12, 3)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items         RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id               String  @id @default(uuid())
  tenantId         String
  recipeId         String
  ingredientId     String
  quantityPerYield Decimal @db.Decimal(12, 4)

  recipe           Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient       Product @relation("RecipeIngredient", fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_items")
}

enum ProductionBatchStatus {
  PLANNED
  PRODUCED
  PARTIALLY_LOST
}

model ProductionBatch {
  id              String                 @id @default(uuid())
  tenantId        String
  finishedProductId String
  quantityProduced Decimal               @db.Decimal(12, 3)
  quantityLost    Decimal                @default(0) @db.Decimal(12, 3)
  status          ProductionBatchStatus  @default(PLANNED)
  producedByUserId String
  producedAt      DateTime               @default(now())

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finishedProduct Product                @relation("ProductionOutput", fields: [finishedProductId], references: [id])

  @@index([tenantId, finishedProductId, producedAt])
  @@map("production_batches")
}

// ─────────────────────────────────────────────────────────────────────────
// ADEGA — CASCOS/VASILHAMES RETORNÁVEIS — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum ContainerLedgerDirection {
  BORROWED
  RETURNED
}

model ReturnableContainerLedger {
  id        String                   @id @default(uuid())
  tenantId  String
  clientId  String
  productId String
  direction ContainerLedgerDirection
  quantity  Int
  saleId    String?
  createdAt DateTime                 @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, productId])
  @@map("returnable_container_ledger")
}

// ─────────────────────────────────────────────────────────────────────────
// ASSISTÊNCIA TÉCNICA — ORDENS DE SERVIÇO — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum WorkOrderStatus {
  RECEIVED
  DIAGNOSING
  AWAITING_APPROVAL
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
}

model WorkOrder {
  id                   String          @id @default(uuid())
  tenantId             String
  clientId             String
  assignedTechnicianId String?
  equipmentDescription String
  reportedIssue        String
  status               WorkOrderStatus @default(RECEIVED)
  diagnosisNotes       String?
  budgetValidUntil     DateTime?
  budgetApprovalToken  String?   @unique
  budgetApprovedAt     DateTime?
  warrantyDays         Int?
  warrantyExclusions   String?
  vehicleId            String?
  deliveredAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTechnician   User?           @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])
  vehicle              Vehicle?        @relation(fields: [vehicleId], references: [id])
  items                WorkOrderItem[]
  checklist            OsChecklist[]
  photos               OsPhoto[]
  productSerials       ProductSerial[]

  @@index([tenantId, status])
  @@index([tenantId, assignedTechnicianId])
  @@map("work_orders")
}

model WorkOrderItem {
  id            String    @id @default(uuid())
  tenantId      String
  workOrderId   String
  productId     String?
  description   String
  itemType      String
  quantity      Decimal   @db.Decimal(12, 3)
  unitPrice     Decimal   @db.Decimal(12, 2)
  commissionable Boolean  @default(false)

  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product       Product?  @relation(fields: [productId], references: [id])

  @@index([tenantId, workOrderId])
  @@map("work_order_items")
}

enum ChecklistStage {
  ENTRY
  DIAGNOSIS
  DELIVERY
}

model OsChecklist {
  id                 String         @id @default(uuid())
  tenantId           String
  workOrderId        String
  stage              ChecklistStage
  items              Json
  clientSignatureUrl String?
  createdAt          DateTime       @default(now())

  workOrder          WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, workOrderId, stage])
  @@map("os_checklists")
}

model OsPhoto {
  id           String   @id @default(uuid())
  tenantId     String
  workOrderId  String
  uploadedById String
  storageKey   String
  caption      String?
  createdAt    DateTime @default(now())

  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, workOrderId])
  @@map("os_photos")
}

// ─────────────────────────────────────────────────────────────────────────
// VENDAS, CAIXA E ESTOQUE — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

/// Status da venda. COMPLETED é o estado normal de uma venda paga na hora —
/// a distinção importa porque o Cap. 6.6 só considera pagamento CONFIRMED.
enum SaleStatus {
  OPEN
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SalePaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  BOLETO
  STORE_CREDIT
}

model Sale {
  id             String      @id @default(uuid())
  tenantId       String
  clientId       String?
  cashierId      String
  cashRegisterId String
  status         SaleStatus  @default(OPEN)
  idempotencyKey String
  paymentMethod  SalePaymentMethod
  totalAmount    Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  channel        String      @default("COUNTER") // DINE_IN | COUNTER | DELIVERY (Cap. 11.1)
  chartOfAccountId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client?      @relation(fields: [clientId], references: [id])
  cashier         User         @relation(fields: [cashierId], references: [id])
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id])
  items           SaleItem[]
  payments        Payment[]
  fiscalDocuments FiscalDocument[]
  accountsReceivable AccountReceivable[]
  comanda         Comanda?

  account                    ChartOfAccount? @relation(fields: [chartOfAccountId], references: [id], map: "sales_chart_of_account_fkey")

  @@unique([tenantId, idempotencyKey])
  @@index([chartOfAccountId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, cashRegisterId])
  @@map("sales")
}

model SaleItem {
  id               String          @id @default(uuid())
  tenantId         String
  saleId           String
  productId        String
  productVariantId String?
  quantity         Decimal         @db.Decimal(12, 3)
  unitPrice        Decimal         @db.Decimal(12, 2)
  totalPrice       Decimal         @db.Decimal(12, 2)

  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model Payment {
  id                   String        @id @default(uuid())
  tenantId             String
  saleId               String
  method               SalePaymentMethod
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(12, 2)
  tefAuthorizationCode String?
  idempotencyKey       String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sale                 Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId, status])
  @@map("payments")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id            String             @id @default(uuid())
  tenantId      String
  openedById    String
  status        CashRegisterStatus @default(OPEN)
  openingAmount Decimal            @db.Decimal(12, 2)
  closingAmount Decimal?           @db.Decimal(12, 2)
  expectedAmount Decimal?          @db.Decimal(12, 2)
  divergenceAmount Decimal?        @db.Decimal(12, 2)
  openedAt      DateTime           @default(now())
  closedAt      DateTime?

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy      User               @relation(fields: [openedById], references: [id])
  sales         Sale[]

  movements                  CashRegisterMovement[]
  @@index([tenantId, status])
  @@map("cash_registers")
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RECIPE_CONSUMPTION
  PRODUCTION_CONSUMPTION
  LOSS
  RETURN
}

model StockMovement {
  id             String             @id @default(uuid())
  tenantId       String
  productId      String
  productBatchId String?
  type           StockMovementType
  quantity       Decimal            @db.Decimal(12, 3)
  /// Descrição legível do motivo (ex.: "Venda PDV (FEFO)", "Perda: pães do dia").
  reason         String?
  /// Código estruturado do motivo, para relatórios (ex.: "SALE", "EXPIRY").
  reasonCode     String?
  referenceId    String?
  createdAt      DateTime           @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [productId], references: [id])
  productBatch   ProductBatch?      @relation(fields: [productBatchId], references: [id])

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, type])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────
// FINANCEIRO — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum PayableStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model AccountPayable {
  id            String        @id @default(uuid())
  tenantId      String
  supplierId    String
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  status        PayableStatus @default(PENDING)
  paidAt        DateTime?
  sourceNfeKey  String?
  accountId     String?
  costCenterId  String?
  purchaseOrderId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id])

  account                    ChartOfAccount? @relation(fields: [accountId], references: [id], map: "accounts_payable_account_fkey")
  costCenter                 CostCenter? @relation(fields: [costCenterId], references: [id], map: "accounts_payable_cost_center_fkey")
  purchaseOrder              PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], map: "accounts_payable_purchase_order_fkey")

  @@index([accountId])
  @@index([costCenterId])
  @@index([purchaseOrderId])
  @@index([tenantId, status, dueDate])
  @@map("accounts_payable")
}

enum ReceivableStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model AccountReceivable {
  id          String           @id @default(uuid())
  tenantId    String
  clientId    String
  saleId      String?
  description String
  amount      Decimal          @db.Decimal(12, 2)
  dueDate     DateTime
  status      ReceivableStatus @default(PENDING)
  paidAt      DateTime?
  accountId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId], references: [id])
  sale        Sale?            @relation(fields: [saleId], references: [id])

  account                    ChartOfAccount? @relation(fields: [accountId], references: [id], map: "accounts_receivable_account_fkey")

  charge                     PaymentCharge?

  @@index([accountId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, clientId])
  @@map("accounts_receivable")
}

// ─────────────────────────────────────────────────────────────────────────
// DOCUMENTOS FISCAIS — Cap. 5
// ─────────────────────────────────────────────────────────────────────────

enum FiscalDocumentType {
  NFCE
  NFE_SAIDA
  NFE_ENTRADA
}

enum FiscalDocumentStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELLED
}

model FiscalDocument {
  id              String                @id @default(uuid())
  tenantId        String
  saleId          String?
  type            FiscalDocumentType
  status          FiscalDocumentStatus  @default(PENDING)
  accessKey       String?               @unique
  xmlStorageKey   String?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale            Sale?                 @relation(fields: [saleId], references: [id], onDelete: Cascade)

  events                     FiscalDocumentEvent[]
  @@index([tenantId, status])
  @@index([tenantId, saleId])
  @@map("fiscal_documents")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — SERVIÇOS E AGENDAMENTO (Petshop, Salão, Estética, Oficina)
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id                     String   @id @default(uuid())
  tenantId               String
  name                   String
  nicheTag               String
  basePrice              Decimal  @db.Decimal(12, 2)
  estimatedDurationMinutes Int
  commissionPercentage   Decimal  @db.Decimal(5, 2) @default(0)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())

  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments           Appointment[]
  clientPackages         ClientServicePackage[]
  contractItems          ServiceContractItem[]

  @@index([tenantId, nicheTag])
  @@map("services")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  clientId        String
  serviceId       String
  professionalId  String
  petId           String?
  vehicleId       String?
  scheduledAt     DateTime
  durationMinutes Int
  status          AppointmentStatus @default(SCHEDULED)
  comandaId       String?
  createdAt       DateTime          @default(now())

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id])
  professional    User              @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  pet             Pet?              @relation(fields: [petId], references: [id])
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id])

  @@unique([tenantId, professionalId, scheduledAt])
  @@index([tenantId, clientId])
  @@map("appointments")
}

model ClientServicePackage {
  id               String   @id @default(uuid())
  tenantId         String
  clientId         String
  serviceId        String
  totalSessions    Int
  sessionsUsed     Int      @default(0)
  purchasedAt      DateTime @default(now())
  expiresAt        DateTime?

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service          Service  @relation(fields: [serviceId], references: [id])

  @@index([tenantId, clientId, serviceId])
  @@map("client_service_packages")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — COMANDA ELETRÔNICA (Restaurante, Salão)
// ─────────────────────────────────────────────────────────────────────────

model RestaurantTable {
  id        String  @id @default(uuid())
  tenantId  String
  label     String
  seatCount Int
  active    Boolean @default(true)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comandas  Comanda[]

  @@unique([tenantId, label])
  @@map("restaurant_tables")
}

enum ComandaStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Comanda {
  id        String        @id @default(uuid())
  tenantId  String
  tableId   String?
  clientId  String?
  status    ComandaStatus @default(OPEN)
  saleId    String?       @unique
  openedAt  DateTime      @default(now())
  closedAt  DateTime?

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table     RestaurantTable? @relation(fields: [tableId], references: [id])
  client    Client?          @relation(fields: [clientId], references: [id])
  sale      Sale?            @relation(fields: [saleId], references: [id])
  items     ComandaItem[]

  @@index([tenantId, status])
  @@map("comandas")
}

model ComandaItem {
  id         String  @id @default(uuid())
  tenantId   String
  comandaId  String
  productId  String?
  serviceId  String?
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(12, 2)
  sentToKdsAt DateTime?

  comanda    Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])

  @@index([tenantId, comandaId])
  @@map("comanda_items")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — ÓTICA
// ─────────────────────────────────────────────────────────────────────────

model OpticalPrescription {
  id                String   @id @default(uuid())
  tenantId          String
  clientId          String
  prescribingDoctor String
  rightEyeSphere    Decimal  @db.Decimal(4, 2)
  rightEyeCylinder  Decimal  @db.Decimal(4, 2)
  rightEyeAxis      Int
  leftEyeSphere     Decimal  @db.Decimal(4, 2)
  leftEyeCylinder   Decimal  @db.Decimal(4, 2)
  leftEyeAxis       Int
  addition          Decimal? @db.Decimal(4, 2)
  pupillaryDistance Decimal? @db.Decimal(4, 1)
  registeredAt      DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@map("optical_prescriptions")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — PETSHOP/VETERINÁRIA
// ─────────────────────────────────────────────────────────────────────────

model Pet {
  id          String   @id @default(uuid())
  tenantId    String
  ownerId     String
  name        String
  species     String
  breed       String?
  birthDate   DateTime?
  weightKg    Decimal? @db.Decimal(6, 2)
  createdAt   DateTime @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       Client          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vaccineRecords VaccineRecord[]
  appointments   Appointment[]

  @@index([tenantId, ownerId])
  @@map("pets")
}

model VaccineRecord {
  id            String   @id @default(uuid())
  tenantId      String
  petId         String
  vaccineName   String
  appliedAt     DateTime
  nextDoseDueAt DateTime?
  appliedByUserId String

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet           Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([tenantId, petId, nextDoseDueAt])
  @@map("vaccine_records")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPANSÃO CAP. 12 — SETOR AUTOMOTIVO
// ─────────────────────────────────────────────────────────────────────────

model Vehicle {
  id           String   @id @default(uuid())
  tenantId     String
  ownerId      String
  licensePlate String
  chassisNumber String?
  model        String
  manufactureYear Int?
  mileageKm    Int?
  createdAt    DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner        Client        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workOrders   WorkOrder[]
  appointments Appointment[]

  @@unique([tenantId, licensePlate])
  @@index([tenantId, ownerId])
  @@map("vehicles")
}

enum VehicleListingStatus {
  AVAILABLE
  RESERVED
  SOLD
  CONSIGNED
}

model VehicleListing {
  id                  String               @id @default(uuid())
  tenantId            String
  chassisNumber       String
  licensePlate        String?
  model               String
  manufactureYear     Int
  mileageKm           Int
  askingPrice         Decimal              @db.Decimal(12, 2)
  status              VehicleListingStatus @default(AVAILABLE)
  consignorClientId   String?
  consignmentCommissionPercentage Decimal? @db.Decimal(5, 2)
  atpveDocumentStorageKey String?
  soldAt              DateTime?
  createdAt           DateTime             @default(now())

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consignorClient     Client?  @relation(fields: [consignorClientId], references: [id])

  @@unique([tenantId, chassisNumber])
  @@index([tenantId, status])
  @@map("vehicle_listings")
}

// ─────────────────────────────────────────────────────────────────────────
// CONTRATO DE SERVIÇO — emissão de contrato formal entre tenant e cliente
// ─────────────────────────────────────────────────────────────────────────

enum ContractStatus {
  DRAFT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model ServiceContract {
  id              String        @id @default(uuid())
  tenantId        String
  clientId        String
  contractNumber  String        @unique
  title           String
  description     String?
  status          ContractStatus @default(DRAFT)
  totalAmount     Decimal       @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  signedAt        DateTime?
  pdfStorageKey   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items           ServiceContractItem[]

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@map("service_contracts")
}

model ServiceContractItem {
  id              String   @id @default(uuid())
  tenantId        String
  contractId      String
  serviceId       String?
  description     String
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)

  contract        ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service         Service?   @relation(fields: [serviceId], references: [id])

  @@index([tenantId, contractId])
  @@map("service_contract_items")
}

// ─────────────────────────────────────────────────────────────────────────
// COMISSÃO DE TÉCNICO — registro financeiro de comissão por O.S.
// ─────────────────────────────────────────────────────────────────────────

model TechnicianCommission {
  id              String   @id @default(uuid())
  tenantId        String
  workOrderId     String
  technicianId    String
  baseAmount      Decimal  @db.Decimal(12, 2)
  percentage      Decimal  @db.Decimal(5, 2)
  amount          Decimal  @db.Decimal(12, 2)
  releasedAt      DateTime @default(now())

  @@unique([tenantId, workOrderId])
  @@index([tenantId, technicianId])
  @@map("technician_commissions")
}

// ─────────────────────────────────────────────────────────────────────────
// AUDIT LOG — imutável (apenas append)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "tenant_audit_logs")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_audit_logs")

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICAÇÕES CENTRAIS — multi-canal (in-app, e-mail, push, WhatsApp, SMS)
// ─────────────────────────────────────────────────────────────────────────

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id           String               @id @default(uuid())
  tenantId     String
// userId OU tenantId (notificacao de transmissao para o tenant inteiro).
// Tem de ser NULLABLE por dois motivos, nao por estetica:
//  1. a relacao e SetNull (exclusao de usuario) - se fosse NOT NULL,
//     o SET NULL abortaria em runtime (o proprio prisma validate avisa);
//  2. notificacao de tenant (broadcast / admin) nao tem usuario destinatario.
  recipientId  String?
  category     String
  title        String
  body         String
  priority     NotificationPriority @default(NORMAL)
  status       String               @default("UNREAD") // UNREAD | READ | ARCHIVED
  sourceType   String?              // "WHATSAPP" | "EMAIL" | "PUSH" | "SMS" | "IN_APP" | "SYSTEM"
  sourceId     String?              // ID do recurso que originou a notificação
  actionUrl    String?              // URL de ação ao clicar na notificação
  readAt       DateTime?
  expiresAt    DateTime?
  data         Json?                // Dados adicionais da notificação
  metadata     Json?                // Metadados adicionais da notificação
  createdAt    DateTime             @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "tenant_notifications")
  recipient    User?    @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([tenantId, recipientId, readAt])
  @@index([tenantId, category])
  @@index([tenantId, sourceType, sourceId])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  enabledChannels String[] @default(["IN_APP"])
  whatsappOptIn   Boolean  @default(false)
  emailOptIn      Boolean  @default(true)
  pushOptIn       Boolean  @default(true)
  smsOptIn        Boolean  @default(false)
  quietHoursStart String?  // HH:MM
  quietHoursEnd   String?  // HH:MM
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_preferences")
}

model PushDeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  String   // "ios" | "android" | "web"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId, active])
  @@map("push_device_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// 2FA / AUTH EXTRAS
// ─────────────────────────────────────────────────────────────────────────

model TwoFactorBackupCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin     PlatformAdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade, map: "admin_backup_codes")

  @@index([userId, usedAt])
  @@map("two_factor_backup_codes")
}

/// Token de redefinição de senha — Cap. 14.3.
///
/// Armazena o SHA-256 do token, nunca o token em si: um dump do banco não pode
/// permitir redefinição de senha. `usedAt` garante uso único.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tenantId, expiresAt])
  @@map("password_reset_tokens")
}

model ActiveSession {
  id            String   @id @default(uuid())
  userId        String
  sessionId     String   @unique
  ipAddress     String?
  userAgent     String?
  lastActivity  DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("active_sessions")
}

