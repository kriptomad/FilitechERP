// ─────────────────────────────────────────────────────────────────────────
// COBRANÇA: BOLETO E PIX — Cap. 17.5
// ─────────────────────────────────────────────────────────────────────────

/// Canal de cobrança — Cap. 2.7 / 17.5. SUBSCRIPTION distingue a cobrança
/// recorrente de assinatura das cobranças avulsas de serviço.
enum ChargeType {
  BOLETO
  PIX
  CREDIT_CARD
  SUBSCRIPTION
}

enum ChargeStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

/// Cobrança real do gateway (Asaas / Mercado Pago / Stripe) — Cap. 2.7 / 9.3.
///
/// Gap corrigido: o checkout ativava o Tenant sem NENHUMA confirmação do
/// provedor (a UI dizia "Assinar" e o cliente já saía com tudo liberado).
/// Aqui o pagamento é materializado em um Charge próprio, e a Subscription só é
/// promovida para ACTIVE quando o webhook chega.
model PaymentCharge {
  id                 String       @id @default(uuid())
  tenantId           String
  /// Vínculo opcional com contas a receber (cobrança avulsa de serviço).
  accountReceivableId String?     @unique
  /// Vínculo opcional com a assinatura origem (cobrança de recorrência).
  subscriptionId     String?
  /// Snapshot do que foi cobrado: plano e add-ons podem mudar depois.
  planCode           String?
  moduleCodes        String[]
  type               ChargeType
  status             ChargeStatus @default(PENDING)
  amount             Decimal      @db.Decimal(12, 2)
  /// Provedor usado (asaas | mercadopago | stripe) — resolve qual webhook
  /// processará esta cobrança.
  provider           String
  /// ID da cobrança/assinatura no provedor.
  externalProviderId String?
  pixQrCodePayload   String?      // payload EMV do QR Code Pix dinâmico
  pixQrCodeBase64    String?      @db.Text // PNG pronto, evita round-trip ao gateway
  boletoDigitableLine String?
  boletoPdfStorageKey String?
  hostedCheckoutUrl  String?      // checkout hospedado (cartão)
  dueDate            DateTime?
  expiresAt          DateTime
  paidAt             DateTime?
  failureReason      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountReceivable AccountReceivable? @relation(fields: [accountReceivableId], references: [id])
  subscription      Subscription?     @relation(fields: [subscriptionId], references: [id])
  billingEvents     BillingEvent[]

  @@index([tenantId, status])
  @@index([provider, externalProviderId])
  @@map("payment_charges")
}

// ─────────────────────────────────────────────────────────────────────────
// PLANO DE CONTAS E CENTRO DE CUSTO — Cap. 17.1
// ─────────────────────────────────────────────────────────────────────────

enum AccountNature {
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id          String        @id @default(uuid())
  tenantId    String
  code        String        // ex.: "3.1.01" — estrutura hierárquica por código
  name        String
  nature      AccountNature
  parentId    String?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      ChartOfAccount?   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[]  @relation("AccountHierarchy")
  costCenters CostCenter[]
  sales       Sale[]
  accountsPayable    AccountPayable[]
  accountsReceivable AccountReceivable[]

  @@unique([tenantId, code])
  @@map("chart_of_accounts")
}

model CostCenter {
  id        String  @id @default(uuid())
  tenantId  String
  accountId String
  code      String? // identificador técnico estável (ex.: "FOLHA_PAGAMENTO"), distinto de `name`
  name      String

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account        ChartOfAccount   @relation(fields: [accountId], references: [id])
  accountsPayable AccountPayable[]

  @@unique([tenantId, code])
  @@map("cost_centers")
}

// ─────────────────────────────────────────────────────────────────────────
// MÓDULO DE COMPRAS — Pedido de Compra, Recebimento e Sugestão de Reposição — Cap. 17.8
// ─────────────────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEVED
  CANCELLED
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  tenantId      String
  supplierId    String
  status        PurchaseOrderStatus @default(DRAFT)
  orderNumber   Int                 // sequencial por tenant, exibido ao fornecedor (ex.: "Pedido #142")
  expectedAt    DateTime?
  notes         String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  createdBy     User                @relation(fields: [createdById], references: [id])
  items         PurchaseOrderItem[]
  accountsPayable AccountPayable[]  // gerado automaticamente no recebimento (17.8.2)

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  tenantId         String
  purchaseOrderId  String
  productId        String
  quantityOrdered  Decimal       @db.Decimal(12, 3)
  quantityReceived Decimal       @db.Decimal(12, 3) @default(0)
  unitCost         Decimal       @db.Decimal(12, 4)
  batchNumber      String?
  expirationDate   DateTime?

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────────────────────────────────
// CONTAGEM FÍSICA DE ESTOQUE (INVENTÁRIO/BALANÇO) E RECONCILIAÇÃO — Cap. 17.9
// ─────────────────────────────────────────────────────────────────────────

enum InventoryCountStatus {
  OPEN
  RECONCILING
  APPROVED
  CANCELLED
}

model InventoryCount {
  id            String                @id @default(uuid())
  tenantId      String
  code          String                // sequencial amigável, ex.: "INV-2025-014"
  status        InventoryCountStatus  @default(OPEN)
  scope         String                // "FULL" (balanço geral) ou "CATEGORY:{categoryId}" ou "LOCATION:{storageLocationId}"
  startedAt     DateTime              @default(now())
  startedByUserId String
  approvedAt    DateTime?
  approvedByUserId String?
  notes         String?

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedBy     User                  @relation("InventoryCountStartedBy", fields: [startedByUserId], references: [id])
  approvedBy    User?                 @relation("InventoryCountApprovedBy", fields: [approvedByUserId], references: [id])
  items         InventoryCountItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id                String          @id @default(uuid())
  inventoryCountId  String
  productId         String
  productBatchId    String?         // em produtos com lote (Farmácia, Padaria), a contagem é por lote
  expectedQuantity  Decimal         @db.Decimal(14, 3) // saldo teórico no momento em que a contagem deste item foi iniciada (snapshot)
  countedQuantity   Decimal?        @db.Decimal(14, 3) // preenchido pelo operador com leitor de código de barras em campo
  countedAt         DateTime?
  countedByUserId   String?
  divergenceReason  String?         // obrigatório quando |counted - expected| > 0, nunca opcional (auditoria exige motivo)

  inventoryCount    InventoryCount  @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  productBatch      ProductBatch?   @relation(fields: [productBatchId], references: [id])
  countedBy         User?           @relation(fields: [countedByUserId], references: [id])

  @@unique([inventoryCountId, productId, productBatchId])
  @@index([inventoryCountId])
  @@map("inventory_count_items")
}

// ─────────────────────────────────────────────────────────────────────────
// RELATÓRIOS, BI E PORTABILIDADE DE DADOS — Cap. 18
// ─────────────────────────────────────────────────────────────────────────

model ReportDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  createdByUserId String
  name        String
  datasetKey  String  // ex.: "sales", "stock_movements", "work_orders" — fonte pré-aprovada
  dimensions  Json    // ex.: ["product.category", "createdAt.month"]
  metrics     Json    // ex.: ["sum(totalAmount)", "count(*)"]
  filters     Json
  chartType   String  // "TABLE" | "BAR" | "LINE" | "PIE"
  isPinnedToDashboard Boolean @default(false)
  createdAt   DateTime @default(now())

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdByUserId], references: [id])
  scheduledReports ScheduledReport[]

  @@index([tenantId, isPinnedToDashboard])
  @@map("report_definitions")
}

model ScheduledReport {
  id               String   @id @default(uuid())
  tenantId         String
  reportDefinitionId String
  cronExpression   String // ex.: "0 8 * * 1" (toda segunda às 8h)
  recipientEmails  String[]
  format           String // "PDF" | "XLSX"
  active           Boolean  @default(true)
  lastRunAt        DateTime?
  createdAt        DateTime @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("scheduled_reports")
}

model DashboardLayout {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String   @unique // um layout por usuário — não compartilhado entre papéis
  widgets   Json     // array ordenado de { reportDefinitionId, x, y, w, h }
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("dashboard_layouts")
}

