  regime             IbsCbsRegimeOptante
  semestreReferencia String
  janelaAbreEm       DateTime
  janelaFechaEm      DateTime
  eleitoEm           DateTime            @default(now())
  eleitoPorUserId    String

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eleitoPorUser       User               @relation(fields: [eleitoPorUserId], references: [id])

  @@unique([tenantId, semestreReferencia])
  @@index([tenantId, eleitoEm])
  @@map("tenant_ibs_cbs_regime_elections")
}

// ─────────────────────────────────────────────────────────────────────────
// LEIAUTES OFICIAIS VERSIONADOS (ECD/ECF/EFD-Reinf/DEFIS) — Cap. 21.18.7
// ─────────────────────────────────────────────────────────────────────────

model OfficialDocumentLayoutVersion {
  id                String                  @id @default(uuid())
  documentType      OfficialTaxDocumentType
  layoutVersion     String
  sourceDescription String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  createdAt         DateTime                @default(now())

  @@index([documentType, effectiveFrom])
  @@map("official_document_layout_versions")
}

enum OfficialTaxDocumentType {
  ECD
  ECF
  EFD_REINF
  DCTFWEB
  DEFIS
