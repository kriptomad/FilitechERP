{
  "$schema": "BIBLE_ENGINEERING_V2.md — Cap. 9 — API Contracts",
  "envelope": {
    "type": "ApiEnvelope",
    "shape": {
      "success": "boolean",
      "data": "T | null",
      "error": "{ code, message, details? } | null",
      "upsell": "{ moduleCode, label, price, checkoutUrl }? (present on MODULE_NOT_ACTIVE)"
    }
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/login",
      "auth": "none",
      "request": { "email": "string", "password": "string" },
      "responses": {
        "200": { "accessToken": "string", "refreshToken": "string", "user": { "id", "name", "role", "tenantId", "tenantSubdomain" }, "activeModules": "string[]" },
        "402": { "error.code": "TENANT_SUSPENDED" }
      }
    },
    {
      "method": "POST",
      "path": "/api/billing/checkout",
      "auth": "none (public calculator)",
      "request": { "planCode": "string", "selectedModuleCodes": "string[]", "billingCycle": "MONTHLY", "paymentGateway": "ASAAS" },
      "responses": {
        "200": { "subscriptionId": "string", "computedMrr": "number", "breakdown": "{code,label,price}[]", "checkoutRedirectUrl": "string" }
      }
    },
    {
      "method": "POST",
      "path": "/api/work-orders",
      "auth": "session + module(work-order)",
      "request": { "clientId", "equipmentDescription", "reportedIssue", "checklistEntry.items[] },
      "responses": { "201": { "workOrderId", "status": "RECEIVED", "protocolNumber", "whatsappApprovalPreviewUrl" } }
    },
    {
      "method": "PATCH",
      "path": "/api/work-orders/:id/budget",
      "auth": "session + module(work-order)",
      "responses": { "200": { "workOrderId", "status": "AWAITING_APPROVAL", "budgetValidUntil", "whatsappApprovalUrl" } }
    },
    {
      "method": "POST",
      "path": "/api/sales",
      "auth": "session + module(pdv), header Idempotency-Key required",
      "request": { "idempotencyKey", "cashRegisterId", "items[]", "paymentMethod", "amountTendered", "closedAtClientTimestamp" },
      "responses": {
        "201": { "saleId", "status": "PAID", "totalAmount", "changeDue", "fiscalDocumentStatus": "PENDING" },
        "200": { "saleId", "status": "PAID", "totalAmount", "changeDue", "fiscalDocumentStatus": "AUTHORIZED", "note": "Venda já processada anteriormente" }
      }
    },
    {
      "method": "GET",
      "path": "/api/work-orders/:id/events",
      "auth": "session + module(work-order)",
      "protocol": "SSE",
      "events": ["status-changed"]
    },
    {
      "method": "POST",
      "path": "/api/billing/modules/:moduleCode/activate",
      "auth": "session + role OWNER/MANAGER",
      "responses": { "200": { "moduleCode", "active": true } }
    }
  ]
}
